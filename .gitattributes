# Force LF line endings for shell scripts (prevents Docker "not found" errors)
*.sh text eol=lf
docker/*.sh text eol=lf
scripts/*.sh text eol=lf

# Force LF for Dockerfiles
Dockerfile* text eol=lf
docker/Dockerfile* text eol=lf

# Keep Windows batch files with CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.gguf binary
*.so binary
*.a binary
*.dll binary
*.exe binary

# Test fixtures are compared byte for byte (golden output, corpus digests):
# check them out exactly as stored, never with converted line endings.
*.golden -text
**/testdata/** -text

# Frozen binary node payloads must never be decoded as textual diffs.
pkg/storage/testdata/node-runtime-v4/*.bin binary
pkg/storage/testdata/node-runtime-v4/*.msgpack binary
