WITH 2 AS i CREATE (:CSa)-[r:$(CASE i WHEN 1 THEN 'X' WHEN 2 THEN 'CY' ELSE 'Z' END)]->(:CSa) RETURN type(r) AS t;
RETURN 382 AS stmt;
WITH 2 AS i MATCH (:CSa)-[r:$(CASE i WHEN 1 THEN 'X' WHEN 2 THEN 'CY' ELSE 'Z' END)]->(:CSa) RETURN type(r) AS t;
