// form plain
RETURN 1 AS stmt;
WITH 1 AS i CREATE (a:RIa {id:1})-[r:DZ {w:17}]->(b:RIa {id:2})-[r2:DZ {w:17}]->(c:RIa {id:3}) RETURN type(r) AS t, r.w AS w, type(r2) = type(r) AS same;
RETURN 2 AS stmt;
WITH 1 AS i MATCH (a:RIa)-[r:DZ]->(b:RIa) RETURN type(r) AS t, a.id AS a, b.id AS b ORDER BY a;
RETURN 3 AS stmt;
WITH 1 AS i MATCH (a:RIa)-[r:DZ {w:17}]->(b:RIa {id:2}) RETURN type(r) AS t, a.id AS a;
RETURN 4 AS stmt;
WITH 1 AS i MATCH (a:RIa)-[r:DZ WHERE r.w = 17]->(b:RIa {id:3}) RETURN type(r) AS t, a.id AS a;
RETURN 5 AS stmt;
WITH 1 AS i MATCH (a:RIa {id:1}) OPTIONAL MATCH (a)-[r:DZ {w:17}]->(b) RETURN type(r) AS t, b.id AS b;
RETURN 6 AS stmt;
WITH 1 AS i MATCH (a:RIa {id:3}) OPTIONAL MATCH (a)-[r:DZ]->(b) RETURN type(r) AS t, b.id AS b;
RETURN 7 AS stmt;
WITH 1 AS i MATCH p=(a:RIa {id:1})-[r:DZ*1..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 8 AS stmt;
WITH 1 AS i MATCH p=(a:RIa {id:1})-[r:DZ*1..2 {w:17}]->(b) RETURN length(p) AS len ORDER BY len;
RETURN 9 AS stmt;
WITH 1 AS i MATCH (a:RIa {id:1}) OPTIONAL MATCH p=(a)-[r:DZ*2]->(b) RETURN length(p) AS len, b.id AS b;
RETURN 10 AS stmt;
WITH 1 AS i MATCH (a:RIa {id:1}), (b:RIa {id:2}) MERGE (a)-[r:DZ {w:17}]->(b) ON CREATE SET r.n = 1 ON MATCH SET r.n = coalesce(r.n, 0) + 1 RETURN type(r) AS t, r.n AS n;
RETURN 11 AS stmt;
WITH 1 AS i MATCH (a:RIa {id:1}), (b:RIa {id:2}) MERGE (a)-[r:DZ {w:17}]->(b) ON CREATE SET r.n = 1 ON MATCH SET r.n = coalesce(r.n, 0) + 1 RETURN type(r) AS t, r.n AS n;
RETURN 12 AS stmt;
MATCH (a:RIa {id:1})-[r]->(b:RIa {id:2}) RETURN count(r) AS rels, sum(r.n) AS n;
RETURN 13 AS stmt;
WITH 1 AS i MERGE (a:RIa {id:4})-[r:DZ {w:17}]->(b:RIa {id:5}) RETURN type(r) AS t;
RETURN 14 AS stmt;
WITH 1 AS i MERGE (a:RIa {id:4})-[r:DZ {w:17}]->(b:RIa {id:5}) RETURN type(r) AS t;
RETURN 15 AS stmt;
MATCH (n:RIa) WHERE n.id IN [4, 5] OPTIONAL MATCH (n)-[r]->() RETURN count(DISTINCT n) AS nodes, count(r) AS rels;
RETURN 16 AS stmt;
UNWIND [{a:10, b:11, i:1}, {a:10, b:11, i:1}, {a:11, b:12, i:1}] AS row MERGE (a:RIa {id:row.a}) MERGE (b:RIa {id:row.b}) MERGE (a)-[r:DZ]->(b) ON CREATE SET r.n = 1 ON MATCH SET r.n = r.n + 1 RETURN type(r) AS t, r.n AS n;
RETURN 17 AS stmt;
MATCH (a:RIa)-[r]->(b:RIa) WHERE a.id >= 10 AND a.id < 20 RETURN a.id AS a, b.id AS b, type(r) AS t, r.n AS n ORDER BY a;
RETURN 18 AS stmt;
UNWIND [1, 2] AS x WITH x, 1 AS i CREATE (:RIa {ws:x})-[:DZ {w:100 + x}]->(:RIa {ws:x}) WITH x, i MATCH (:RIa)-[r:DZ]->() WHERE r.w > 100 RETURN x, count(r) AS c ORDER BY x;
RETURN 19 AS stmt;
UNWIND [1, 2] AS x WITH x, 1 AS i MATCH (s:RIa {ws:x})-[r:DZ]->() SET r.v = x WITH x, i MATCH (:RIa)-[q:DZ {v:1}]->() RETURN x, count(q) AS c ORDER BY x;
RETURN 20 AS stmt;
UNWIND [1, 2] AS x WITH x, 1 AS i MATCH (s:RIa {ws:x}) MERGE (s)-[r:DZ {u:x}]->(:RIa {ws:x + 10}) WITH x, i MATCH (:RIa)-[q:DZ WHERE q.u IS NOT NULL]->() RETURN x, count(q) AS c ORDER BY x;
RETURN 21 AS stmt;
EXPLAIN WITH 1 AS i MATCH (a:RIa)-[r:DZ {w:17}]->(b) RETURN type(r) AS t;
RETURN 22 AS stmt;
PROFILE WITH 1 AS i MATCH (a:RIa)-[r:DZ {w:17}]->(b) RETURN type(r) AS t, count(*) AS c;
RETURN 23 AS stmt;
EXPLAIN WITH 1 AS i MERGE (a:RIa {id:30})-[r:DZ]->(b:RIa {id:31}) RETURN type(r) AS t;
RETURN 24 AS stmt;
PROFILE WITH 1 AS i MATCH (a:RIa {id:1}) OPTIONAL MATCH (a)-[r:DZ*1..2]->(b) RETURN count(b) AS c;
