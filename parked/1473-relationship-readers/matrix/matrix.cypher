UNWIND [1, 2] AS x WITH x, 1 AS i CREATE (:RIm {ws:x})-[:`D"Z]->(x)` {w:100 + x}]->(:RIm {ws:x}) WITH x, i MATCH (:RIm)-[r:`D"Z]->(x)`]->() WHERE r.w > 100 RETURN x, count(r) AS c ORDER BY x;
RETURN 307 AS stmt;
UNWIND [1, 2] AS x WITH x, 1 AS i MATCH (s:RIm {ws:x})-[r:`D"Z]->(x)`]->() SET r.v = x WITH x, i MATCH (:RIm)-[q:`D"Z]->(x)` {v:1}]->() RETURN x, count(q) AS c ORDER BY x;
RETURN 308 AS stmt;
UNWIND [1, 2] AS x WITH x, 1 AS i MATCH (s:RIm {ws:x}) MERGE (s)-[r:`D"Z]->(x)` {u:x}]->(:RIm {ws:x + 10}) WITH x, i MATCH (:RIm)-[q:`D"Z]->(x)` WHERE q.u IS NOT NULL]->() RETURN x, count(q) AS c ORDER BY x;
RETURN 309 AS stmt;
EXPLAIN WITH 1 AS i MATCH (a:RIm)-[r:`D"Z]->(x)` {w:17}]->(b) RETURN type(r) AS t;
RETURN 310 AS stmt;
PROFILE WITH 1 AS i MATCH (a:RIm)-[r:`D"Z]->(x)` {w:17}]->(b) RETURN type(r) AS t, count(*) AS c;
RETURN 311 AS stmt;
EXPLAIN WITH 1 AS i MERGE (a:RIm {id:30})-[r:`D"Z]->(x)`]->(b:RIm {id:31}) RETURN type(r) AS t;
RETURN 312 AS stmt;
PROFILE WITH 1 AS i MATCH (a:RIm {id:1}) OPTIONAL MATCH (a)-[r:`D"Z]->(x)`*1..2]->(b) RETURN count(b) AS c;
// form dynbt
RETURN 313 AS stmt;
WITH 1 AS i CREATE (a:RIn {id:1})-[r:$('D`Z]-(') {w:17}]->(b:RIn {id:2})-[r2:$('D`Z]-(') {w:17}]->(c:RIn {id:3}) RETURN type(r) AS t, r.w AS w, type(r2) = type(r) AS same;
RETURN 314 AS stmt;
WITH 1 AS i MATCH (a:RIn)-[r:$('D`Z]-(')]->(b:RIn) RETURN type(r) AS t, a.id AS a, b.id AS b ORDER BY a;
RETURN 315 AS stmt;
WITH 1 AS i MATCH (a:RIn)-[r:$('D`Z]-(') {w:17}]->(b:RIn {id:2}) RETURN type(r) AS t, a.id AS a;
RETURN 316 AS stmt;
WITH 1 AS i MATCH (a:RIn)-[r:$('D`Z]-(') WHERE r.w = 17]->(b:RIn {id:3}) RETURN type(r) AS t, a.id AS a;
RETURN 317 AS stmt;
WITH 1 AS i MATCH (a:RIn {id:1}) OPTIONAL MATCH (a)-[r:$('D`Z]-(') {w:17}]->(b) RETURN type(r) AS t, b.id AS b;
RETURN 318 AS stmt;
WITH 1 AS i MATCH (a:RIn {id:3}) OPTIONAL MATCH (a)-[r:$('D`Z]-(')]->(b) RETURN type(r) AS t, b.id AS b;
RETURN 319 AS stmt;
WITH 1 AS i MATCH p=(a:RIn {id:1})-[r:$('D`Z]-(')*1..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 320 AS stmt;
WITH 1 AS i MATCH p=(a:RIn {id:1})-[r:$('D`Z]-(')*1..2 {w:17}]->(b) RETURN length(p) AS len ORDER BY len;
RETURN 321 AS stmt;
WITH 1 AS i MATCH (a:RIn {id:1}) OPTIONAL MATCH p=(a)-[r:$('D`Z]-(')*2]->(b) RETURN length(p) AS len, b.id AS b;
RETURN 322 AS stmt;
WITH 1 AS i MATCH (a:RIn {id:1}), (b:RIn {id:2}) MERGE (a)-[r:$('D`Z]-(') {w:17}]->(b) ON CREATE SET r.n = 1 ON MATCH SET r.n = coalesce(r.n, 0) + 1 RETURN type(r) AS t, r.n AS n;
RETURN 323 AS stmt;
WITH 1 AS i MATCH (a:RIn {id:1}), (b:RIn {id:2}) MERGE (a)-[r:$('D`Z]-(') {w:17}]->(b) ON CREATE SET r.n = 1 ON MATCH SET r.n = coalesce(r.n, 0) + 1 RETURN type(r) AS t, r.n AS n;
RETURN 324 AS stmt;
MATCH (a:RIn {id:1})-[r]->(b:RIn {id:2}) RETURN count(r) AS rels, sum(r.n) AS n;
RETURN 325 AS stmt;
WITH 1 AS i MERGE (a:RIn {id:4})-[r:$('D`Z]-(') {w:17}]->(b:RIn {id:5}) RETURN type(r) AS t;
RETURN 326 AS stmt;
WITH 1 AS i MERGE (a:RIn {id:4})-[r:$('D`Z]-(') {w:17}]->(b:RIn {id:5}) RETURN type(r) AS t;
RETURN 327 AS stmt;
MATCH (n:RIn) WHERE n.id IN [4, 5] OPTIONAL MATCH (n)-[r]->() RETURN count(DISTINCT n) AS nodes, count(r) AS rels;
RETURN 328 AS stmt;
UNWIND [{a:10, b:11, i:1}, {a:10, b:11, i:1}, {a:11, b:12, i:1}] AS row MERGE (a:RIn {id:row.a}) MERGE (b:RIn {id:row.b}) MERGE (a)-[r:$('D`Z]-(')]->(b) ON CREATE SET r.n = 1 ON MATCH SET r.n = r.n + 1 RETURN type(r) AS t, r.n AS n;
RETURN 329 AS stmt;
MATCH (a:RIn)-[r]->(b:RIn) WHERE a.id >= 10 AND a.id < 20 RETURN a.id AS a, b.id AS b, type(r) AS t, r.n AS n ORDER BY a;
RETURN 330 AS stmt;
UNWIND [1, 2] AS x WITH x, 1 AS i CREATE (:RIn {ws:x})-[:$('D`Z]-(') {w:100 + x}]->(:RIn {ws:x}) WITH x, i MATCH (:RIn)-[r:$('D`Z]-(')]->() WHERE r.w > 100 RETURN x, count(r) AS c ORDER BY x;
RETURN 331 AS stmt;
UNWIND [1, 2] AS x WITH x, 1 AS i MATCH (s:RIn {ws:x})-[r:$('D`Z]-(')]->() SET r.v = x WITH x, i MATCH (:RIn)-[q:$('D`Z]-(') {v:1}]->() RETURN x, count(q) AS c ORDER BY x;
RETURN 332 AS stmt;
UNWIND [1, 2] AS x WITH x, 1 AS i MATCH (s:RIn {ws:x}) MERGE (s)-[r:$('D`Z]-(') {u:x}]->(:RIn {ws:x + 10}) WITH x, i MATCH (:RIn)-[q:$('D`Z]-(') WHERE q.u IS NOT NULL]->() RETURN x, count(q) AS c ORDER BY x;
RETURN 333 AS stmt;
EXPLAIN WITH 1 AS i MATCH (a:RIn)-[r:$('D`Z]-(') {w:17}]->(b) RETURN type(r) AS t;
RETURN 334 AS stmt;
PROFILE WITH 1 AS i MATCH (a:RIn)-[r:$('D`Z]-(') {w:17}]->(b) RETURN type(r) AS t, count(*) AS c;
RETURN 335 AS stmt;
EXPLAIN WITH 1 AS i MERGE (a:RIn {id:30})-[r:$('D`Z]-(')]->(b:RIn {id:31}) RETURN type(r) AS t;
RETURN 336 AS stmt;
PROFILE WITH 1 AS i MATCH (a:RIn {id:1}) OPTIONAL MATCH (a)-[r:$('D`Z]-(')*1..2]->(b) RETURN count(b) AS c;
// (c) mixed-type dynamic range: hop types differ
RETURN 337 AS stmt;
CREATE (:RMa {id:1})-[:`D{Z}..*` {w:1}]->(:RMa {id:2})-[:DZ {w:1}]->(:RMa {id:3});
RETURN 338 AS stmt;
WITH 'D{Z}..*' AS t MATCH p=(:RMa {id:1})-[r:$(t)*1..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 339 AS stmt;
WITH 'DZ' AS t MATCH p=(:RMa {id:1})-[r:$(t)*1..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 340 AS stmt;
WITH 'NOPE' AS t MATCH p=(:RMa {id:1})-[r:$(t)*1..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 341 AS stmt;
WITH 'NOPE' AS t MATCH p=(:RMa {id:1})-[r:$(t)*0..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 342 AS stmt;
WITH ['NOPE'] AS t MATCH p=(:RMa {id:1})-[r:$any(t)*1..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 343 AS stmt;
WITH 'NOPE' AS t MATCH p=(:RMa {id:1})-[r:$(t)*1..2 {w:1}]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 344 AS stmt;
WITH 'NOPE' AS t MATCH p=(:RMa {id:1})-[r:$(t)*1..2 {w:2}]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 345 AS stmt;
WITH 'NOPE' AS t MATCH p=(:RMa {id:1})-[r:$(t)]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 346 AS stmt;
WITH 'NOPE' AS t MATCH (a:RMa {id:1}) OPTIONAL MATCH p=(a)-[r:$(t)*1..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 347 AS stmt;
MATCH p=(:RMa {id:1})-[r:NOPE*1..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 348 AS stmt;
MATCH p=(:RMa {id:1})-[r:`D{Z}..*`*1..2]->(b) RETURN length(p) AS len, b.id AS b ORDER BY len;
RETURN 349 AS stmt;
UNWIND ['D{Z}..*', 'DZ', 'NOPE', 7, null] AS t MATCH p=(:RMa {id:1})-[r:$(t)*1..2]->(b) RETURN t, length(p) AS len ORDER BY len;
RETURN 350 AS stmt;
WITH 'NOPE' AS t MATCH p=(:RMa {id:1})-[r:$(t)*1..2]->(b) WHERE all(x IN r WHERE type(x) = t) RETURN length(p) AS len;
