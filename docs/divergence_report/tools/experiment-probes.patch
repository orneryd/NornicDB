diff --git a/pkg/cypher/zz_fallthrough_probe.go b/pkg/cypher/zz_fallthrough_probe.go
new file mode 100644
index 00000000..e51c5755
--- /dev/null
+++ b/pkg/cypher/zz_fallthrough_probe.go
@@ -0,0 +1,35 @@
+package cypher
+
+import (
+	"fmt"
+	"os"
+	"sync"
+)
+
+var probeMu sync.Mutex
+
+// NORNIC_STRICT_EVAL=1: the main evaluator returns nil instead of the expression text.
+var probeStrict = os.Getenv("NORNIC_STRICT_EVAL") != ""
+
+// NORNIC_PIPELINE_FIRST=1: the router tries executePipeline before every other rule.
+var probePipelineFirst = os.Getenv("NORNIC_PIPELINE_FIRST") != ""
+
+// probeFallthrough appends "site<TAB>expression" to the file named by
+// NORNIC_FALLTHROUGH_PROBE every time an evaluator returns the expression text as the value.
+func probeFallthrough(site, expr string) {
+	p := os.Getenv("NORNIC_FALLTHROUGH_PROBE")
+	if p == "" {
+		return
+	}
+	if len(expr) > 100 {
+		expr = expr[:100]
+	}
+	probeMu.Lock()
+	defer probeMu.Unlock()
+	f, err := os.OpenFile(p, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+	if err != nil {
+		return
+	}
+	fmt.Fprintf(f, "%s\t%q\n", site, expr)
+	f.Close()
+}
