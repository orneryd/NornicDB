UNWIND [$record, $alternate] AS record
RETURN [at IN range(0, size(coalesce(record.values, [])) - 1) | {scheme: CASE WHEN record.codes[at] = '' THEN null ELSE record.codes[at] END, value: CASE WHEN record.values[at] = '' THEN null ELSE record.values[at] END, issuer: CASE WHEN record.issuers[at] = '' THEN null ELSE record.issuers[at] END, jurisdiction: CASE WHEN record.regions[at] = '' THEN null ELSE record.regions[at] END, period: CASE WHEN record.periods[at] = '' THEN null ELSE record.periods[at] END, category: coalesce(record.categories[at], 'second')}] AS entries,
       CASE WHEN record IS NULL THEN null ELSE toString(uuid.v5('6ba7b810-9dad-11d1-80b4-00c04fd430c8', apoc.convert.toJson([false, record.name, record.codes, record.values, record.issuers, record.regions, record.periods, record.categories, coalesce(record.current, true) <> false]))) END AS version