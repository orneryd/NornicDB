CREATE (:A {id:1}), (:A {id:2}), (:B)-[:R]->(:C {id:9});
MATCH (n:A) CALL (n) { RETURN n.id AS c } WITH n.id AS k, c ORDER BY k RETURN 'R01' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN COLLECT { RETURN n.id }[0] AS c } WITH n.id AS k, c ORDER BY k RETURN 'R02' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { MATCH (m:A) WHERE EXISTS { MATCH (m) WHERE m.id = n.id } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'R03' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN COUNT { MATCH (m:A) WHERE m.id = n.id } AS c } WITH n.id AS k, c ORDER BY k RETURN 'R04' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN COLLECT { MATCH (n:C) RETURN 10 AS v UNION ALL MATCH (m:A) WHERE m.id = n.id RETURN m.id AS v }[0] AS c } WITH n.id AS k, c ORDER BY k RETURN 'R05' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN COLLECT { MATCH (m:A) WHERE m.id = n.id RETURN m.id AS v UNION ALL MATCH (n:C) RETURN 10 AS v }[0] AS c } WITH n.id AS k, c ORDER BY k RETURN 'R06' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN COUNT { MATCH (n:C) RETURN 1 AS v UNION ALL MATCH (m:A) WHERE m.id = n.id RETURN 1 AS v } AS c } WITH n.id AS k, c ORDER BY k RETURN 'R07' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN EXISTS { MATCH (n:C) RETURN 1 AS v UNION MATCH (m:A) WHERE m.id = n.id RETURN 1 AS v } AS c } WITH n.id AS k, c ORDER BY k RETURN 'R08' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN size([(n)-->() | 1]) AS c } WITH n.id AS k, c ORDER BY k RETURN 'R09' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN [x IN [1] | n.id][0] AS c } WITH n.id AS k, c ORDER BY k RETURN 'R10' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { CALL (n) { RETURN n.id AS v } RETURN v AS c } WITH n.id AS k, c ORDER BY k RETURN 'R11' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { CALL { WITH n RETURN n.id AS v } RETURN v AS c } WITH n.id AS k, c ORDER BY k RETURN 'R12' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN COLLECT { MATCH (m:A) RETURN COUNT { MATCH (k:A) WHERE k.id = n.id } AS v }[0] AS c } WITH n.id AS k, c ORDER BY k RETURN 'R13' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { MATCH (m:B) WHERE EXISTS { (m)-->(n) } RETURN count(m) + n.id AS c } WITH n.id AS k, c ORDER BY k RETURN 'R14' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { MATCH (m:A) WHERE EXISTS { (m {id: n.id}) } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'R15' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN COLLECT { MATCH (m:A) WHERE m.id = n.id RETURN [n IN [5] | n][0] + m.id AS v }[0] AS c } WITH n.id AS k, c ORDER BY k RETURN 'R16' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN COLLECT { UNWIND [1] AS k RETURN n.id AS v }[0] AS c } WITH n.id AS k, c ORDER BY k RETURN 'R17' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN EXISTS { MATCH (m:A) WHERE m.id = n.id } AS c } WITH n.id AS k, c ORDER BY k RETURN 'R18' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { MATCH (m:A) RETURN sum(COUNT { MATCH (m) WHERE m = n }) AS c } WITH n.id AS k, c ORDER BY k RETURN 'R19' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL (n) { RETURN COLLECT { MATCH (n:C) RETURN 10 AS v UNION ALL RETURN n.id AS v }[0] AS c } WITH n.id AS k, c ORDER BY k RETURN 'R20' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
