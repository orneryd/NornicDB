CREATE (:A {id:1}), (:A {id:2}), (:B)-[:R]->(:C {id:9});
MATCH (n:A) CALL () { MATCH (m:B) WHERE EXISTS { (m)-->(n) } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D01' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) RETURN COUNT { (m)-->(n) } AS c } WITH n.id AS k, c ORDER BY k RETURN 'D02' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) RETURN size(COLLECT { MATCH (m)-->(n) RETURN n.id }) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D03' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) RETURN size(COLLECT { MATCH (m)-->(x) RETURN COUNT { (x)<--(n) } AS k }) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D04' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) WHERE m.n IS NULL AND EXISTS { (m)-->(n) } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D05' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) WHERE 'n' = 'n' AND EXISTS { (m)-->(n) } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D06' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) WHERE {n: 1}.n = 1 AND EXISTS { (m)-->(n) } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D07' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { RETURN COLLECT { MATCH (m:B) RETURN size([(m)-->(n) | n]) AS s }[0] AS c } WITH n.id AS k, c ORDER BY k RETURN 'D08' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { RETURN size([n IN [1, 2] | n * 10]) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D09' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { RETURN reduce(s = 0, n IN [1, 2] | s + n) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D10' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { RETURN all(n IN [1, 2] WHERE n > 0) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D11' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { RETURN size(COLLECT { MATCH (n:C) RETURN n.id AS v UNION ALL MATCH (m:B) RETURN 0 AS v }) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D12' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { CALL () { MATCH (n:C) RETURN n.id AS v } RETURN v AS c } WITH n.id AS k, c ORDER BY k RETURN 'D13' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (n:C) RETURN n.id AS c } WITH n.id AS k, c ORDER BY k RETURN 'D14' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { UNWIND [5] AS n RETURN n AS c } WITH n.id AS k, c ORDER BY k RETURN 'D15' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { WITH 7 AS n RETURN n AS c } WITH n.id AS k, c ORDER BY k RETURN 'D16' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) RETURN COUNT { MATCH (m) ((x)-[:R]->(n)){1,1} } AS c } WITH n.id AS k, c ORDER BY k RETURN 'D17' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) /* n */ RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D18' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) WHERE EXISTS { (m)-->(`n`) } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D19' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) WHERE NOT EXISTS { (m)-->(:n) } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D20' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) WHERE NOT EXISTS { (m)-[:n]->() } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D21' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { RETURN COUNT { MATCH (n:C) RETURN 1 AS v UNION MATCH (n:B) RETURN 2 AS v } AS c } WITH n.id AS k, c ORDER BY k RETURN 'D22' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) WHERE EXISTS { MATCH (m)-->(n) WHERE n.id = 9 } RETURN count(m) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D23' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
MATCH (n:A) CALL () { MATCH (m:B) RETURN size([x IN COLLECT { MATCH (m)-->(n) RETURN n } | x]) AS c } WITH n.id AS k, c ORDER BY k RETURN 'D24' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
WITH 1 AS n CALL () { MATCH (m:B) WHERE EXISTS { (m)-->(n) } RETURN count(m) AS c } WITH n AS k, c ORDER BY k RETURN 'S01' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
WITH 1 AS n CALL () { MATCH (m:B) RETURN COUNT { (m)-->(n) } AS c } WITH n AS k, c ORDER BY k RETURN 'S02' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
WITH 1 AS n CALL () { MATCH (n:C) RETURN n.id AS c } WITH n AS k, c ORDER BY k RETURN 'S03' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
WITH 'x' AS n CALL () { RETURN COLLECT { MATCH (m:B)-->(n) RETURN n.id }[0] AS c } WITH n AS k, c ORDER BY k RETURN 'S04' AS q, collect(toString(k) + ':' + coalesce(toString(c), 'null')) AS r;
