+import { expect, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as WorkspaceGateway from "./WorkspaceGateway.ts";
+
+it.effect("writes only a current bounded file and preserves source on stale requests", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const gateway = yield* WorkspaceGateway.WorkspaceGateway;
+    const root = yield* fs.makeTempDirectoryScoped({ prefix: "nornic-gateway-" });
+    yield* fs.writeFileString(path.join(root, "answer.py"), "answer = 41\n");
+    const initial = yield* gateway.read(root, "answer.py");
+    expect(
+      (yield* gateway.write(root, "answer.py", "wrong-hash", "answer = 42\n").pipe(Effect.exit))
+        ._tag,
+    ).toBe("Failure");
+    expect((yield* gateway.read(root, "answer.py")).content).toBe(initial.content);
+    for (const resource of ["../outside.py", "C:/outside.py", "/outside.py", "sub\\outside.py"])
+      expect((yield* gateway.read(root, resource).pipe(Effect.exit))._tag).toBe("Failure");
+    const written = yield* gateway.write(root, "answer.py", initial.sha256, "answer = 42\n");
+    expect((yield* gateway.read(root, "answer.py")).sha256).toBe(written.sha256);
+    expect(
+      (yield* gateway.write(root, "answer.py", initial.sha256, "answer = 99\n").pipe(Effect.exit))
+        ._tag,
+    ).toBe("Failure");
+  }).pipe(
+    Effect.scoped,
+    Effect.provide(
+      Layer.merge(
+        NodeServices.layer,
+        WorkspaceGateway.layer.pipe(
+          Layer.provide(Layer.merge(NodeCrypto.layer, NodeServices.layer)),
+        ),
+      ),
+    ),
+  ),
+);
diff --git a/apps/server/src/nornic/WorkspaceGateway.ts b/apps/server/src/nornic/WorkspaceGateway.ts
new file mode 100644
index 0000000000..cff6ee1c32
--- /dev/null
+++ b/apps/server/src/nornic/WorkspaceGateway.ts
@@ -0,0 +1,119 @@
+import * as Context from "effect/Context";
+import * as Crypto from "effect/Crypto";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+
+export class WorkspaceGatewayError extends Schema.TaggedError<WorkspaceGatewayError>()(
+  "WorkspaceGatewayError",
+  { reason: Schema.String, cause: Schema.optionalKey(Schema.Defect()) },
+) {
+  override get message() {
+    return this.reason;
+  }
+}
+export class WorkspaceGateway extends Context.Service<
+  WorkspaceGateway,
+  {
+    readonly hash: (content: string) => Effect.Effect<string, WorkspaceGatewayError>;
+    readonly read: (
+      workspace: string,
+      resource: string,
+    ) => Effect.Effect<
+      { readonly content: string; readonly sha256: string },
+      WorkspaceGatewayError
+    >;
+    readonly write: (
+      workspace: string,
+      resource: string,
+      expectedHash: string,
+      content: string,
+    ) => Effect.Effect<{ readonly sha256: string }, WorkspaceGatewayError>;
+  }
+>()("t3/nornic/WorkspaceGateway") {}
+
+const isGatewayError = Schema.is(WorkspaceGatewayError);
+const make = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const crypto = yield* Crypto.Crypto;
+  const hash = Effect.fn("WorkspaceGateway.hash")(function* (content: string) {
+    if (new TextEncoder().encode(content).byteLength > 1048576)
+      return yield* new WorkspaceGatewayError({
+        reason: "The proposed file exceeds the 1 MiB action limit.",
+      });
+    const bytes = yield* crypto
+      .digest("SHA-256", new TextEncoder().encode(content))
+      .pipe(Effect.orDie);
+    return Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
+  });
+  const resolve = Effect.fn("WorkspaceGateway.resolve")(
+    function* (workspace: string, resource: string) {
+      if (
+        !resource ||
+        resource.length > 4096 ||
+        /[\\:\0]/.test(resource) ||
+        resource.startsWith("/") ||
+        resource.split("/").some((part) => !part || part === "." || part === "..")
+      )
+        return yield* new WorkspaceGatewayError({
+          reason: "Use a canonical repository-relative file path.",
+        });
+      const root = yield* fs.realPath(workspace);
+      const target = yield* fs.realPath(path.join(root, resource));
+      const relative = path.relative(root, target);
+      if (!relative || relative.startsWith("..") || path.isAbsolute(relative))
+        return yield* new WorkspaceGatewayError({
+          reason: "The file resolves outside the assigned workspace.",
+        });
+      const stat = yield* fs.stat(target);
+      if (stat.type !== "File" || Number(stat.size) > 1048576)
+        return yield* new WorkspaceGatewayError({
+          reason: "The gateway supports existing text files up to 1 MiB.",
+        });
+      return target;
+    },
+    Effect.mapError((cause) =>
+      isGatewayError(cause)
+        ? cause
+        : new WorkspaceGatewayError({ reason: "The workspace file could not be resolved.", cause }),
+    ),
+  );
+  const read = Effect.fn("WorkspaceGateway.read")(
+    function* (workspace: string, resource: string) {
+      const target = yield* resolve(workspace, resource);
+      const content = yield* fs.readFileString(target);
+      return { content, sha256: yield* hash(content) };
+    },
+    Effect.mapError((cause) =>
+      isGatewayError(cause)
+        ? cause
+        : new WorkspaceGatewayError({ reason: "The workspace file could not be read.", cause }),
+    ),
+  );
+  const write = Effect.fn("WorkspaceGateway.write")(
+    function* (workspace: string, resource: string, expectedHash: string, content: string) {
+      const sha256 = yield* hash(content);
+      const target = yield* resolve(workspace, resource);
+      const current = yield* fs.readFileString(target);
+      if ((yield* hash(current)) !== expectedHash)
+        return yield* new WorkspaceGatewayError({
+          reason: "SOURCE_CHANGED: reread the current file and revise the edit.",
+        });
+      yield* fs.writeFileString(target, content);
+      return { sha256 };
+    },
+    Effect.mapError((cause) =>
+      isGatewayError(cause)
+        ? cause
+        : new WorkspaceGatewayError({
+            reason: "The write outcome requires reconciliation.",
+            cause,
+          }),
+    ),
+  );
+  return WorkspaceGateway.of({ hash, read, write });
+});
+export const layer = Layer.effect(WorkspaceGateway, make);
