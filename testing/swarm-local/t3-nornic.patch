+import { expect, it } from "vite-plus/test";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import * as Classifier from "./IntentClassifier.ts";
+import * as Tracker from "./LinearTracker.ts";
+import * as Context from "./CodeContext.ts";
+import * as Assistant from "./IntentReadAssistant.ts";
+
+const page = {
+  viewer: { id: "viewer", name: "Fixture" },
+  issues: [],
+  pageInfo: { hasNextPage: false, endCursor: null },
+};
+function run(
+  decisions: Array<typeof Classifier.ReadDecision.Type>,
+  history: ReadonlyArray<Classifier.IntentConversationMessage> = [],
+) {
+  let calls = 0;
+  const reads: unknown[] = [];
+  const prompts: string[] = [];
+  const effect = Assistant.make.pipe(
+    Effect.flatMap((assistant) => assistant.answer("List my assigned Linear issues", history)),
+    Effect.provideService(
+      Classifier.IntentClassifier,
+      Classifier.IntentClassifier.of({
+        classify: () => Effect.die("Unexpected classification"),
+        readDecision: (text) => {
+          prompts.push(text);
+          calls++;
+          return Effect.succeed(decisions.shift()!);
+        },
+      }),
+    ),
+    Effect.provideService(
+      Tracker.LinearTracker,
+      Tracker.LinearTracker.of({
+        getIssue: () =>
+          Effect.fail(new Tracker.LinearTrackerError({ reason: "fixture read failed" })),
+        listAssigned: (options) => {
+          reads.push(options);
+          return Effect.succeed(page);
+        },
+      }),
+    ),
+    Effect.provideService(
+      Context.CodeContext,
+      Context.CodeContext.of({ search: () => Effect.die("Unexpected search") }),
+    ),
+  );
+  return { result: Effect.runPromise(effect), reads, prompts, calls: () => calls };
+}
+
+it("executes bounded reads and returns the evidence-backed answer without a coding worker", async () => {
+  const probe = run([
+    { action: "tool", operation: "linear.assigned" },
+    { action: "answer", answer: "Fixture has no open assigned NOR issues." },
+  ]);
+  expect(await probe.result).toMatchObject({
+    outcome: "answered",
+    evidence: [{ operation: "linear.assigned", result: page }],
+  });
+  expect(probe.reads).toEqual([{ first: 10, after: undefined, includeCompleted: undefined }]);
+  expect(probe.calls()).toBe(2);
+});
+
+it("asks for missing user information without inventing results or calling tools", async () => {
+  const probe = run([{ action: "clarify", answer: "Which issue identifier should I inspect?" }]);
+  expect(await probe.result).toMatchObject({ outcome: "clarification", evidence: [] });
+  expect(probe.reads).toHaveLength(0);
+});
+
+it("does not accept a fabricated answer without evidence", async () => {
+  const probe = run([{ action: "answer", answer: "Invented result" }]);
+  expect(await probe.result).toMatchObject({ outcome: "limit", evidence: [] });
+});
+
+it("stops repeated tool calls and passes through requests outside read-only scope", async () => {
+  const loop = run([
+    { action: "tool", operation: "linear.assigned" },
+    { action: "tool", operation: "linear.assigned" },
+  ]);
+  expect(await loop.result).toMatchObject({ outcome: "limit" });
+  expect(loop.reads).toHaveLength(1);
+  expect(await run([{ action: "pass" }]).result).toBeNull();
+});
+
+it("rejects mutation decisions and preserves actual tool errors", async () => {
+  expect(() =>
+    Schema.decodeUnknownSync(Classifier.ReadDecision)({ action: "tool", operation: "file.write" }),
+  ).toThrow();
+  await expect(
+    run([{ action: "tool", operation: "linear.issue", issueId: "NOR-1" }]).result,
+  ).rejects.toThrow("fixture read failed");
+});
+
+it("passes bounded conversation context to resolve a clarification reply", async () => {
+  const history = [{ role: "assistant" as const, text: "Which issue identifier?" }];
+  const probe = run([{ action: "clarify", answer: "Which issue?" }], history);
+  await probe.result;
+  expect(JSON.parse(probe.prompts[0]!).clarificationContext).toEqual(history);
+});
diff --git a/apps/server/src/nornic/IntentReadAssistant.ts b/apps/server/src/nornic/IntentReadAssistant.ts
new file mode 100644
index 0000000000..079f4f5aaa
--- /dev/null
+++ b/apps/server/src/nornic/IntentReadAssistant.ts
@@ -0,0 +1,106 @@
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import * as IntentClassifier from "./IntentClassifier.ts";
+import * as LinearTracker from "./LinearTracker.ts";
+import * as CodeContext from "./CodeContext.ts";
+
+export interface ReadAnswer {
+  readonly outcome: "answered" | "clarification" | "limit";
+  readonly answer: string;
+  readonly evidence: ReadonlyArray<{ readonly operation: string; readonly result: unknown }>;
+}
+export class IntentReadAssistant extends Context.Service<
+  IntentReadAssistant,
+  {
+    readonly answer: (
+      text: string,
+      history?: ReadonlyArray<IntentClassifier.IntentConversationMessage>,
+    ) => Effect.Effect<
+      ReadAnswer | null,
+      | IntentClassifier.IntentClassificationError
+      | LinearTracker.LinearTrackerError
+      | CodeContext.CodeContextError
+    >;
+  }
+>()("t3/nornic/IntentReadAssistant") {}
+
+const encode = Schema.encodeSync(Schema.fromJsonString(Schema.Unknown));
+
+/** Bounded controller: the model chooses among existing read services, never arbitrary tools. */
+export const make = Effect.gen(function* () {
+  const model = yield* IntentClassifier.IntentClassifier;
+  const tracker = yield* LinearTracker.LinearTracker;
+  const context = yield* CodeContext.CodeContext;
+  const answer = Effect.fn("IntentReadAssistant.answer")(function* (
+    text: string,
+    history: ReadonlyArray<IntentClassifier.IntentConversationMessage> = [],
+  ) {
+    if (text.length > 6000) return null;
+    const evidence: Array<{ operation: string; result: unknown }> = [];
+    const seen = new Set<string>();
+    let used = 0;
+    for (let step = 0; step < 4; step++) {
+      const decision = yield* model.readDecision(
+        encode({
+          user: text,
+          clarificationContext: history,
+          evidence,
+          remainingReads: 3 - evidence.length,
+        }),
+      );
+      if (decision.action === "pass") return null;
+      if (decision.action === "clarify" && decision.answer?.trim())
+        return { outcome: "clarification" as const, answer: decision.answer, evidence };
+      if (decision.action === "answer" && decision.answer?.trim() && evidence.length)
+        return { outcome: "answered" as const, answer: decision.answer, evidence };
+      if (decision.action !== "tool" || !decision.operation || evidence.length >= 3) break;
+      const key = encode([
+        decision.operation,
+        decision.issueId,
+        decision.query,
+        decision.contextScope,
+        decision.after,
+        decision.includeCompleted,
+      ]);
+      if (seen.has(key)) break;
+      seen.add(key);
+      let result: unknown;
+      switch (decision.operation) {
+        case "linear.assigned":
+          result = yield* tracker.listAssigned({
+            first: 10,
+            after: decision.after,
+            includeCompleted: decision.includeCompleted,
+          });
+          break;
+        case "linear.issue":
+          result = yield* tracker.getIssue(decision.issueId ?? "");
+          break;
+        case "context.search":
+          result = yield* context.search(decision.query ?? "", decision.contextScope);
+          break;
+      }
+      const serialized = encode(result);
+      used += serialized.length;
+      if (used > 18000) {
+        return {
+          outcome: "limit" as const,
+          answer:
+            "The read returned more information than the intake budget allows. Please narrow the issue or search query; no complete answer has been established.",
+          evidence,
+        };
+      }
+      evidence.push({ operation: decision.operation, result });
+    }
+    return {
+      outcome: "limit" as const,
+      answer:
+        "The bounded intake read could not establish a complete answer. Please narrow the request or ask to continue the specific lookup. No state was changed.",
+      evidence,
+    };
+  });
+  return IntentReadAssistant.of({ answer });
+});
+export const layer = Layer.effect(IntentReadAssistant, make);
