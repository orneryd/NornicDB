+import { describe, expect, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as IntentClassifier from "./IntentClassifier.ts";
+
+describe.runIf(process.env.NORNIC_INTENT_LIVE_TEST === "1")(
+  "live Ollama classification (requires NORNIC_INTENT_LIVE_TEST=1)",
+  () => {
+    it.live("distinguishes a simple question from architecture work using the local model", () =>
+      Effect.gen(function* () {
+        const classifier = yield* IntentClassifier.IntentClassifier;
+        const simple = yield* classifier.classify(
+          "What does the word idempotent mean? Answer briefly; do not change code.",
+        );
+        expect(simple.kind).toBe("question");
+        expect(simple.tier).toBe("local");
+        const implementation = yield* classifier.classify(
+          "Implement this approved bugfix plan: in calc.py replace value + value with value * value. Baseline square(3) incorrectly returns 6. Acceptance: square(3)=9 and square(-4)=16. Validate with python -m unittest. No design work is needed.",
+        );
+        expect(implementation.kind).toBe("bugfix");
+        expect(implementation.tier).toBe("local");
+        const complex = yield* classifier.classify(
+          "Design a distributed durable ownership and execution architecture across T3, NornicDB, Codex, Copilot and Linear. Resolve transaction, crash-recovery, identity and process-isolation boundaries. Produce a plan, not source edits.",
+        );
+        expect(complex.tier).toBe("frontier");
+        expect(complex.instructions).not.toContain(simple.instructions);
+      }).pipe(Effect.provide(IntentClassifier.layer)),
+    );
+  },
+);
