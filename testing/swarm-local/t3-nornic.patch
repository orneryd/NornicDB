+import { describe, expect, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as ProcessRunner from "../processRunner.ts";
+import * as DuplicateGate from "./DuplicateGate.ts";
+
+describe.runIf(process.env.NORNIC_DUPLICATE_LIVE_TEST === "1")(
+  "live mandatory duplicate admission",
+  () => {
+    it.live(
+      "blocks a known copy with advice, preserves the real index, and passes after removal",
+      () =>
+        Effect.gen(function* () {
+          const fs = yield* FileSystem.FileSystem;
+          const path = yield* Path.Path;
+          const runner = yield* ProcessRunner.ProcessRunner;
+          const gate = yield* DuplicateGate.DuplicateGate;
+          const source = process.env.NORNIC_DUPLICATE_FIXTURE_ROOT;
+          if (!source)
+            return yield* Effect.die(
+              "Set NORNIC_DUPLICATE_FIXTURE_ROOT to the indexed acceptance fixture.",
+            );
+          const temp = yield* fs.makeTempDirectoryScoped({ prefix: "t3-duplicate-live-" });
+          const workspace = path.join(temp, "swarm-workflow-fixture");
+          const git = Effect.fn("DuplicateGate.integration.git")(function* (
+            args: ReadonlyArray<string>,
+          ) {
+            const result = yield* runner.run({ command: "git", args, cwd: temp });
+            expect(result.code, result.stderr).toBe(0);
+            return result.stdout.trim();
+          });
+          yield* git(["clone", "--shared", source, workspace]);
+          // Keep the fixture's canonical primary-folder identity without a remote.
+          yield* git(["-C", workspace, "remote", "remove", "origin"]);
+          const tree = yield* git(["-C", workspace, "write-tree"]);
+          const candidate = path.join(workspace, "candidate.py");
+          const baseline = yield* fs.readFileString(candidate);
+          const canonical = yield* fs.readFileString(path.join(workspace, "canonical.py"));
+          yield* fs.writeFileString(
+            candidate,
+            canonical.replace("calculate_total", "candidate_total"),
+          );
+          const blocked = yield* gate.check(workspace);
+          expect(blocked.passed).toBe(false);
+          expect(blocked.advice).toContain("canonical.py");
+          expect(blocked.advice).toContain("MANDATORY REFACTOR");
+          expect(yield* git(["-C", workspace, "write-tree"])).toBe(tree);
+          yield* fs.writeFileString(candidate, baseline);
+          const resolved = yield* gate.check(workspace);
+          expect(resolved.passed).toBe(true);
+          expect(resolved.treeHash).toBe(tree);
+        }).pipe(
+          Effect.scoped,
+          Effect.provide(
+            Layer.mergeAll(
+              NodeServices.layer,
+              ProcessRunner.layer.pipe(Layer.provide(NodeServices.layer)),
+              DuplicateGate.layer.pipe(
+                Layer.provide(ProcessRunner.layer),
+                Layer.provide(NodeServices.layer),
+              ),
+            ),
+          ),
+        ),
+    );
+  },
+);
