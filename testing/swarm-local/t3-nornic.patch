+import { expect, it } from "vite-plus/test";
+import { latestUserIntent } from "./intentSource.ts";
+
+it("never treats a delegated completion or provider follow-up as a new user instruction", () => {
+  const original = {
+    role: "user",
+    createdBy: "agent",
+    creationSource: "mcp",
+    id: "external-cli",
+  } as const;
+  const completion = {
+    ...original,
+    id: "completion",
+    delegatedCompletion: { parentRunId: "run", generation: 1, taskIds: [] },
+  };
+  const provider = { ...original, id: "provider", creationSource: "provider" } as const;
+  const system = { ...original, id: "system", createdBy: "system" } as const;
+  const routed = { ...original, id: "routed", creationSource: "server" } as const;
+  expect(latestUserIntent([original, completion, provider, system, routed])).toBe(original);
+  const next = { ...original, id: "next-user", createdBy: "user", creationSource: "web" } as const;
+  expect(latestUserIntent([original, completion, next])).toBe(next);
+});
