@@ -0,0 +1,16 @@
+import * as Config from "effect/Config";
+import * as Effect from "effect/Effect";
+import * as HttpClientRequest from "effect/http/HttpClientRequest";
+
+/** Attach the configured NornicDB credentials to every remote HTTP request. */
+export const request = Effect.gen(function* () {
+  const token = yield* Config.String("NORNICDB_TOKEN").pipe(Config.withDefault(""));
+  const user = yield* Config.String("NORNICDB_USER").pipe(Config.withDefault(""));
+  const password = yield* Config.String("NORNICDB_PASSWORD").pipe(Config.withDefault(""));
+  if (token) return HttpClientRequest.setHeader("Authorization", `Bearer ${token}`);
+  if (user && password) {
+    const value = Buffer.from(`${user}:${password}`).toString("base64");
+    return HttpClientRequest.setHeader("Authorization", `Basic ${value}`);
+  }
+  return (httpRequest: HttpClientRequest.HttpClientRequest) => httpRequest;
+});
