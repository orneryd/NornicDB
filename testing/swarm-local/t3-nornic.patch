+import { describe, expect, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as LinearTracker from "./LinearTracker.ts";
+
+describe.runIf(process.env.NORNIC_LINEAR_LIVE_TEST === "1")("live Linear read-only intake", () => {
+  it.live("lists the API-key owner's assignments with an explicit account and pagination", () =>
+    Effect.gen(function* () {
+      const tracker = yield* LinearTracker.LinearTracker;
+      const page = yield* tracker.listAssigned({first: 2});
+      expect(page.viewer.id.length).toBeGreaterThan(0);
+      expect(page.viewer.name.length).toBeGreaterThan(0);
+      expect(page.issues.length).toBeLessThanOrEqual(2);
+      expect(page.issues.every((issue) => issue.team.key === "NOR" && issue.assignee?.id === page.viewer.id)).toBe(true);
+      if (page.pageInfo.hasNextPage) {
+        expect(page.pageInfo.endCursor).toBeTruthy();
+        const next = yield* tracker.listAssigned({first: 2, after: page.pageInfo.endCursor!});
+        expect(next.viewer.id).toBe(page.viewer.id);
+        expect(next.issues.every((issue) => !page.issues.some((previous) => previous.id === issue.id))).toBe(true);
+      }
+    }).pipe(Effect.provide(LinearTracker.layer)),
+  );
+  it.live("reads current NOR scope without changing external fields", () =>
+    Effect.gen(function* () {
+      const tracker = yield* LinearTracker.LinearTracker;
+      const issue = yield* tracker.getIssue("NOR-53");
+      expect(issue.identifier).toBe("NOR-53");
+      expect(issue.team.key).toBe("NOR");
+      expect(issue.updatedAt.length).toBeGreaterThan(0);
+      expect(issue.state.id.length).toBeGreaterThan(0);
+      expect(issue.url).toMatch(/^https:\/\/linear.app\//);
+      const repeated = yield* tracker.getIssue(issue.id);
+      expect(repeated.updatedAt).toBe(issue.updatedAt);
+    }).pipe(Effect.provide(LinearTracker.layer)),
+  );
+});
