+import * as Schema from "effect/Schema";
+
+export const NornicWorkflowRequest = Schema.Struct({
+  operation: Schema.Literals([
+    "capabilities",
+    "intent.classify",
+    "intent.route",
+    "workflow.validate",
+    "file.read",
+    "file.write",
+    "task.create",
+    "task.get",
+    "plan.put",
+    "claim.acquire",
+    "claim.release",
+    "session.heartbeat",
+    "workflow.next",
+    "linear.issue",
+    "linear.bind",
+    "context.search",
+  ]),
+  issueId: Schema.optionalKey(Schema.String),
+  query: Schema.optionalKey(Schema.String),
+  path: Schema.optionalKey(Schema.String),
+  content: Schema.optionalKey(Schema.String),
+  expectedHash: Schema.optionalKey(Schema.String),
+  requestId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(256)),
+  taskId: Schema.optionalKey(
+    Schema.String.annotate({
+      description:
+        "Required for ALL task, plan, claim, file, validation and Linear binding operations. Choose a stable id on task.create and reuse it throughout the task.",
+    }),
+  ),
+  expectedVersion: Schema.optionalKey(Schema.Int),
+  title: Schema.optionalKey(Schema.String),
+  acceptanceCriteria: Schema.optionalKey(Schema.Array(Schema.String)),
+  steps: Schema.optionalKey(Schema.Array(Schema.String)),
+  validation: Schema.optionalKey(Schema.Array(Schema.String)),
+  resources: Schema.optionalKey(Schema.Array(Schema.String)),
+  reason: Schema.optionalKey(Schema.String),
+  generation: Schema.optionalKey(Schema.Int),
+  ttlSeconds: Schema.optionalKey(Schema.Int),
+});
+
+export const NornicWorkflowResponse = Schema.Struct({
+  ok: Schema.Boolean,
+  code: Schema.String,
+  data: Schema.Record(Schema.String, Schema.Unknown),
+  version: Schema.Int,
+  requestId: Schema.String,
+});
