+import { expect, it } from "vite-plus/test";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as Effect from "effect/Effect";
+import * as HttpClientRequest from "effect/http/HttpClientRequest";
+import * as NornicAuth from "./NornicAuth.ts";
+
+const header = (values: Record<string, string>) =>
+  Effect.runPromise(
+    Effect.gen(function* () {
+      const authenticate = yield* NornicAuth.request;
+      const request = HttpClientRequest.get("http://localhost/health");
+      return authenticate(request).headers.authorization;
+    }).pipe(Effect.provide(ConfigProvider.layer(ConfigProvider.fromEnv({ env: values })))),
+  );
+
+it("uses a bearer token when configured", async () => {
+  expect(
+    await header({ NORNICDB_TOKEN: "test-token", NORNICDB_USER: "u", NORNICDB_PASSWORD: "p" }),
+  ).toBe("Bearer test-token");
+});
+
+it("uses basic credentials when no token is configured", async () => {
+  expect(await header({ NORNICDB_USER: "u", NORNICDB_PASSWORD: "p" })).toBe("Basic dTpw");
+});
+
+it("does not invent credentials", async () => {
+  expect(await header({})).toBeUndefined();
+});
