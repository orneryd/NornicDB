@@ -0,0 +1,4 @@
+/** Astra requires a user-started T3 session; an MCP agent cannot approve itself. */
+export function requiresUserStartedSession(model: string): boolean {
+  return /^gpt-6-astra(?:$|[-:])/.test(model);
+}
