+import { describe, expect, it } from "vite-plus/test";
+import { emptyState, transition, type Owner } from "./workflowState.ts";
+
+const alice: Owner = {
+  environmentId: "env",
+  threadId: "alice",
+  providerSessionId: "a1",
+  providerInstanceId: "local",
+};
+const bob: Owner = { ...alice, threadId: "bob", providerSessionId: "b1" };
+
+describe("Nornic workflow ownership", () => {
+  it("binds exact Linear scope, invalidates prior admission, and preserves replay across external changes", () => {
+    let state = emptyState();
+    const call = (operation: string, input: Record<string, unknown>) => {
+      const result = transition(
+        state,
+        alice,
+        { operation, requestId: String(state.version), taskId: "a", ...input },
+        1000,
+      );
+      state = result.state;
+      return result.response;
+    };
+    call("task.create", { title: "Bound task", acceptanceCriteria: ["original acceptance"] });
+    call("plan.put", {
+      expectedVersion: 1,
+      resources: ["calc.py"],
+      steps: ["fix"],
+      validation: ["unit test"],
+    });
+    call("claim.acquire", { resources: ["calc.py"], reason: "implement" });
+    const issue = {
