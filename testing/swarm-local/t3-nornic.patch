@@ -0,0 +1,42 @@
+import { describe, expect, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as CodeContext from "./CodeContext.ts";
+
+describe.runIf(process.env.NORNICDB_LIVE_TEST === "1")("live bounded repository retrieval", () => {
+  it.live("retrieves skills and recursive AGENTS guidance with source revision citations", () =>
+    Effect.gen(function* () {
+      const context = yield* CodeContext.CodeContext;
+      for (const query of ["linear implementation subtickets", "standing design principles canonical owner"]) {
+        const result = yield* context.search(query, "help");
+        expect(result.repository).toBe("nornic/intent-help");
+        expect(result.excerpts.length).toBeGreaterThan(0);
+        expect(result.excerpts.every((item) => item.revision?.length === 40)).toBe(true);
+        expect(result.excerpts.some((item) => item.source.includes(query.startsWith("linear") ? "tommyvo/useful-prompts:" : "orneryd/NornicDB:"))).toBe(true);
+      }
+    }).pipe(Effect.provide(CodeContext.layer), Effect.provide(ConfigProvider.layer(ConfigProvider.fromEnv({env: process.env as Record<string, string>})))),
+  );
+  it.live("uses native hybrid search and preserves source and completeness limits", () =>
+    Effect.gen(function* () {
+      const context = yield* CodeContext.CodeContext;
+      const result = yield* context.search("embedding invalidation");
+      expect(result.database).toBe("nornicdbcode");
+      expect(result.excerpts.length).toBeGreaterThan(0);
+      expect(result.excerpts.length).toBeLessThanOrEqual(5);
+      expect(
+        result.excerpts.reduce((size, item) => size + item.text.length, 0),
+      ).toBeLessThanOrEqual(6000);
+      expect(result.excerpts.every((item) => item.source !== "unknown")).toBe(true);
+      expect(result.complete).toBe(false);
+      expect(result.warning).toContain("missing hits do not establish absence");
+      expect((yield* context.search("x".repeat(2001)).pipe(Effect.exit))._tag).toBe("Failure");
+    }).pipe(
+      Effect.provide(CodeContext.layer),
+      Effect.provide(
+        ConfigProvider.layer(
+          ConfigProvider.fromEnv({ env: process.env as Record<string, string> }),
+        ),
+      ),
+    ),
+  );
+});
