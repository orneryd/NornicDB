@@ -0,0 +1,76 @@
+import { afterEach, expect, it, vi } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner";
+import * as ProcessRunner from "../processRunner.ts";
+import * as DuplicateGate from "./DuplicateGate.ts";
+
+afterEach(() => vi.unstubAllEnvs());
+it.effect.each([
+  {
+    exitCode: 1,
+    changed: false,
+    expected: false,
+    description: "blocks findings and preserves mandatory advice",
+  },
+  {
+    exitCode: 0,
+    changed: true,
+    expected: false,
+    description: "rejects successful checks when the candidate changes",
+  },
+  {
+    exitCode: 0,
+    changed: false,
+    expected: true,
+    description: "accepts completed checks only for their exact candidate",
+  },
+])("$description", ({ exitCode, changed, expected }) =>
+  Effect.gen(function* () {
+    vi.stubEnv("NORNIC_DUPLICATE_PYTHON", "python");
+    vi.stubEnv("NORNIC_DUPLICATE_RUNNER", "/protected/code_intelligence.py");
+    vi.stubEnv("NORNIC_GRAPHIFY", "graphify");
+    const snapshots: Array<string> = [];
+    let treeReads = 0;
+    const advice = "MANDATORY REFACTOR BEFORE CHECK-IN: reuse the canonical owner";
+    const runner = ProcessRunner.ProcessRunner.of({
+      run: (input) => {
+        if (input.env?.GIT_INDEX_FILE) snapshots.push(input.env.GIT_INDEX_FILE);
+        const treeRead = input.command === "git" && input.args[0] === "write-tree";
+        if (treeRead) treeReads++;
+        return Effect.succeed({
+          stdout: treeRead
+            ? changed && treeReads > 1
+              ? "tree-b\n"
+              : "tree-a\n"
+            : input.command === "python"
+              ? advice
+              : "",
+          stderr: "",
+          code: ChildProcessSpawner.ExitCode(input.command === "python" ? exitCode : 0),
+          timedOut: false,
+          stdoutTruncated: false,
+          stderrTruncated: false,
+          stdoutInvalidUtf8: false,
+          stderrInvalidUtf8: false,
+        });
+      },
+    });
+    const result = yield* Effect.gen(function* () {
+      return yield* (yield* DuplicateGate.DuplicateGate).check("/private-worktree");
+    }).pipe(
+      Effect.provide(
+        DuplicateGate.layer.pipe(
+          Layer.provide(Layer.succeed(ProcessRunner.ProcessRunner, runner)),
+          Layer.provide(NodeServices.layer),
+        ),
+      ),
+    );
+    expect(result.passed).toBe(expected);
+    expect(result.treeHash).toBe("tree-a");
+    expect(new Set(snapshots).size).toBe(1);
+    expect(snapshots[0]).not.toContain("/private-worktree/.git/index");
+    if (!changed) expect(result.advice).toBe(advice);
+  }),
+);
diff --git a/apps/server/src/nornic/DuplicateGate.ts b/apps/server/src/nornic/DuplicateGate.ts
new file mode 100644
index 0000000000..7b7c81f045
--- /dev/null
+++ b/apps/server/src/nornic/DuplicateGate.ts
@@ -0,0 +1,107 @@
+import * as Config from "effect/Config";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import * as ProcessRunner from "../processRunner.ts";
+
+export interface DuplicateReceipt {
+  readonly passed: boolean;
+  readonly treeHash: string;
+  readonly exitCode: number | null;
+  readonly advice: string;
+}
+export class DuplicateGateError extends Schema.TaggedError<DuplicateGateError>()(
+  "DuplicateGateError",
+  { cause: Schema.Defect() },
+) {
+  override get message() {
+    return "The mandatory duplicate check could not complete. Validation remains blocked.";
+  }
+}
+export class DuplicateGate extends Context.Service<
+  DuplicateGate,
+  {
+    readonly check: (workspace: string) => Effect.Effect<DuplicateReceipt, DuplicateGateError>;
+  }
+>()("t3/nornic/DuplicateGate") {}
+
+const make = Effect.gen(function* () {
+  const runner = yield* ProcessRunner.ProcessRunner;
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const python = yield* Config.String("NORNIC_DUPLICATE_PYTHON").pipe(Config.withDefault(""));
+  const script = yield* Config.String("NORNIC_DUPLICATE_RUNNER").pipe(Config.withDefault(""));
+  const graphify = yield* Config.String("NORNIC_GRAPHIFY").pipe(Config.withDefault(""));
+  const uri = yield* Config.String("NORNICDB_WORKFLOW_URL").pipe(
+    Config.withDefault("http://127.0.0.1:7474"),
+  );
+  const database = yield* Config.String("NORNIC_CODE_DATABASE").pipe(
+    Config.withDefault("nornicdbcode"),
+  );
+  const user = yield* Config.String("NORNICDB_USER").pipe(Config.withDefault(""));
+  const password = yield* Config.String("NORNICDB_PASSWORD").pipe(Config.withDefault(""));
+  const check = Effect.fn("DuplicateGate.check")(
+    function* (workspace: string) {
+      if (!python || !script || !graphify)
+        return yield* new DuplicateGateError({
+          cause:
+            "Configure NORNIC_DUPLICATE_PYTHON, NORNIC_DUPLICATE_RUNNER and NORNIC_GRAPHIFY in the harness environment.",
+        });
+      const temp = yield* fs.makeTempDirectoryScoped({ prefix: "t3-duplicate-" });
+      const env = {
+        GIT_INDEX_FILE: path.join(temp, "index"),
+        NORNICDB_URI: uri,
+        NORNICDB_DATABASE: database,
+        NORNICDB_USER: user,
+        NORNICDB_PASSWORD: password,
+        CODE_INTEL_GRAPHIFY: graphify,
+        PYTHONUTF8: "1",
+      };
+      const git = Effect.fn("DuplicateGate.snapshot")(function* (args: ReadonlyArray<string>) {
+        const result = yield* runner.run({ command: "git", args, cwd: workspace, env });
+        if (result.code !== 0)
+          return yield* new DuplicateGateError({ cause: { command: "git", args, ...result } });
+        return result.stdout.trim();
+      });
+      yield* git(["read-tree", "HEAD"]);
+      yield* git(["add", "--all", "--", "."]);
+      const treeHash = yield* git(["write-tree"]);
+      const result = yield* runner.run({
+        command: python,
+        args: [script, "check-staged", "--repo-root", workspace],
+        cwd: workspace,
+        env,
+        timeout: "6 minutes",
+        maxOutputBytes: 262144,
+      });
+      yield* git(["add", "--all", "--", "."]);
+      const currentTree = yield* git(["write-tree"]);
+      const advice = [result.stdout, result.stderr].filter(Boolean).join("\n");
+      if (currentTree !== treeHash)
+        return {
+          passed: false,
+          treeHash,
+          exitCode: null,
+          advice:
+            "Source changed during duplicate analysis. Rerun against the current candidate; the previous result does not authorize validation.",
+        };
+      return {
+        passed:
+          result.code === 0 &&
+          !result.timedOut &&
+          !result.stdoutTruncated &&
+          !result.stderrTruncated,
+        treeHash,
+        exitCode: result.code === null ? null : Number(result.code),
+        advice,
+      };
+    },
+    Effect.scoped,
+    Effect.mapError((cause) => new DuplicateGateError({ cause })),
+  );
+  return DuplicateGate.of({ check });
+});
+export const layer = Layer.effect(DuplicateGate, make);
