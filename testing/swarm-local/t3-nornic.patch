+  ),
+  nornic_discover: McpToolAccess.readsAsCaller((args) =>
+    Effect.gen(function* () {
+      const service = yield* NornicMcp.NornicMcp;
+      return yield* service.call("discover", args);
+    }),
+  ),
+  nornic_link: McpToolAccess.actsAsCaller((args) =>
+    Effect.gen(function* () {
+      const service = yield* NornicMcp.NornicMcp;
+      return yield* service.call("link", args);
+    }),
+  ),
+  nornic_tasks: McpToolAccess.actsAsCaller((args) =>
+    Effect.gen(function* () {
+      const service = yield* NornicMcp.NornicMcp;
+      return yield* service.call("tasks", args);
+    }),
+  ),
+});
