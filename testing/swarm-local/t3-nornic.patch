+import * as Effect from "effect/Effect";
+import * as NornicMcp from "../../../nornic/NornicMcp.ts";
+import * as McpToolAccess from "../../McpToolAccess.ts";
+import { NornicGraphToolkit } from "./graphTools.ts";
+export const layer = McpToolAccess.toLayer(NornicGraphToolkit, {
+  nornic_store: McpToolAccess.actsAsCaller((args) =>
