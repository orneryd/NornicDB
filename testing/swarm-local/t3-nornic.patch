diff --git a/apps/server/src/nornic/LinearTracker.ts b/apps/server/src/nornic/LinearTracker.ts
new file mode 100644
index 0000000000..4ae1c24cee
--- /dev/null
+++ b/apps/server/src/nornic/LinearTracker.ts
@@ -0,0 +1,96 @@
+import * as Config from "effect/Config";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as Schema from "effect/Schema";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+
+const Named = Schema.Struct({ id: Schema.String, name: Schema.String });
+export const Issue = Schema.Struct({
+  id: Schema.String,
+  identifier: Schema.String,
+  title: Schema.String,
+  description: Schema.NullOr(Schema.String),
+  url: Schema.String,
+  updatedAt: Schema.String,
+  priority: Schema.Number,
+  team: Schema.Struct({ id: Schema.String, key: Schema.String }),
+  project: Schema.NullOr(Named),
+  projectMilestone: Schema.NullOr(Named),
+  assignee: Schema.NullOr(Named),
+  state: Schema.Struct({ id: Schema.String, name: Schema.String, type: Schema.String }),
+  labels: Schema.Struct({ nodes: Schema.Array(Named) }),
+});
+const Result = Schema.Struct({
+  data: Schema.optionalKey(Schema.NullOr(Schema.Struct({ issue: Schema.NullOr(Issue) }))),
+  errors: Schema.optionalKey(Schema.Array(Schema.Struct({ message: Schema.String }))),
+});
+const decodeResult = Schema.decodeUnknownEffect(Result);
+export class LinearTrackerError extends Schema.TaggedError<LinearTrackerError>()(
+  "LinearTrackerError",
+  { reason: Schema.String },
+) {
+  override get message() {
+    return this.reason;
+  }
+}
+export class LinearTracker extends Context.Service<
+  LinearTracker,
+  {
+    readonly getIssue: (id: string) => Effect.Effect<typeof Issue.Type, LinearTrackerError>;
+  }
+>()("t3/nornic/LinearTracker") {}
+
+const isTrackerError = Schema.is(LinearTrackerError);
+export const make = Effect.gen(function* () {
+  const client = yield* HttpClient.HttpClient;
+  const apiKey = yield* Config.Redacted("LINEAR_API_KEY").pipe(
+    Config.withDefault(Redacted.make("")),
+  );
+  const team = yield* Config.String("NORNIC_LINEAR_TEAM").pipe(Config.withDefault("NOR"));
+  const getIssue = Effect.fn("LinearTracker.getIssue")(
+    function* (id: string) {
+      if (!Redacted.value(apiKey))
+        return yield* new LinearTrackerError({
+          reason: "TRACKER_UNAVAILABLE: configure LINEAR_API_KEY in docker/.env.swarm-local.",
+        });
+      if (!/^(?:[A-Z][A-Z0-9]*-\d+|[a-f0-9-]{36})$/.test(id))
+        return yield* new LinearTrackerError({ reason: "Use a Linear issue identifier or UUID." });
+      const request = yield* HttpClientRequest.post("https://api.linear.app/graphql").pipe(
+        HttpClientRequest.setHeader("Authorization", Redacted.value(apiKey)),
+        HttpClientRequest.bodyJson({
+          query:
+            "query HarnessIssue($id: String!) { issue(id: $id) { id identifier title description url updatedAt priority team { id key } project { id name } projectMilestone { id name } assignee { id name } state { id name type } labels { nodes { id name } } } }",
+          variables: { id },
+        }),
+      );
+      const response = yield* client.execute(request);
+      const result = yield* response.json.pipe(Effect.flatMap(decodeResult));
+      if (response.status !== 200 || result.errors?.length || !result.data?.issue)
+        return yield* new LinearTrackerError({
+          reason: "TRACKER_UNAVAILABLE: issue read failed; no scope or status was changed.",
+        });
+      if (result.data.issue.team.key !== team)
+        return yield* new LinearTrackerError({
+          reason: "TRACKER_MAPPING_INVALID: issue belongs to another team.",
+        });
+      if (result.data.issue.labels.nodes.length >= 50)
+        return yield* new LinearTrackerError({
+          reason: "TRACKER_INCOMPLETE: label pagination must be resolved before intake.",
+        });
+      return result.data.issue;
+    },
+    Effect.timeout("30 seconds"),
+    Effect.mapError((cause) =>
+      isTrackerError(cause)
+        ? cause
+        : new LinearTrackerError({
+            reason:
+              "TRACKER_UNAVAILABLE: request failed or timed out; no external mutation occurred.",
+          }),
+    ),
+  );
+  return LinearTracker.of({ getIssue });
+});
+export const layer = Layer.effect(LinearTracker, make).pipe(Layer.provide(FetchHttpClient.layer));
