+import { expect, it } from "vite-plus/test";
+import * as Effect from "effect/Effect";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as HttpClient from "effect/http/HttpClient";
+import * as HttpClientResponse from "effect/http/HttpClientResponse";
+import * as LinearTracker from "./LinearTracker.ts";
+
+const issue = {
+  id: "issue-1",
+  identifier: "NOR-1",
+  title: "Fixture",
+  url: "https://linear.app/fixture",
+  updatedAt: "2026-10-22T00:00:00Z",
+  priority: 2,
+  team: { id: "team", key: "NOR" },
+  assignee: { id: "viewer", name: "Fixture User" },
+  state: { id: "todo", name: "Todo", type: "unstarted" },
+};
+const run = (
+  action: (
+    tracker: typeof LinearTracker.LinearTracker.Service,
+  ) => Effect.Effect<unknown, LinearTracker.LinearTrackerError>,
+  responses: unknown[],
+  env: Record<string, string> = { LINEAR_API_KEY: "fixture" },
+) => {
+  const requests: Array<{ query: string; variables: Record<string, unknown> }> = [];
+  const client = HttpClient.make((request) => {
+    if (request.body._tag !== "Uint8Array") throw new Error("Expected JSON body");
+    requests.push(JSON.parse(new TextDecoder().decode(request.body.body)));
+    return Effect.succeed(HttpClientResponse.fromWeb(request, Response.json(responses.shift())));
+  });
+  const effect = LinearTracker.make.pipe(
+    Effect.flatMap(action),
+    Effect.provideService(HttpClient.HttpClient, client),
+    Effect.provide(ConfigProvider.layer(ConfigProvider.fromEnv({ env }))),
+  );
+  return { result: Effect.runPromise(effect), requests };
+};
+
+it("resolves the authenticated viewer and returns a bounded assigned page with its cursor", async () => {
+  const { result, requests } = run(
+    (tracker) => tracker.listAssigned({ after: "page-1", first: 10 }),
+    [
+      {
+        data: {
+          viewer: {
+            id: "viewer",
+            name: "Fixture User",
+            assignedIssues: {
+              nodes: [issue],
+              pageInfo: { hasNextPage: true, endCursor: "page-2" },
+            },
+          },
+        },
+      },
+    ],
+  );
+  expect(await result).toMatchObject({
+    viewer: { id: "viewer", name: "Fixture User" },
+    issues: [issue],
+    pageInfo: { hasNextPage: true, endCursor: "page-2" },
+  });
+  expect(requests[0]?.query).toContain("viewer");
+  expect(requests[0]?.query).not.toContain("mutation");
+  expect(requests[0]?.variables).toMatchObject({
+    after: "page-1",
+    first: 10,
+    filter: { team: { key: { eq: "NOR" } }, state: { type: { nin: ["completed", "canceled"] } } },
+  });
+});
+
+it("supports including completed issues without silently changing the account or team", async () => {
+  const { result, requests } = run(
+    (tracker) => tracker.listAssigned({ includeCompleted: true }),
+    [
+      {
+        data: {
+          viewer: {
+            id: "viewer",
+            name: "Fixture User",
+            assignedIssues: { nodes: [], pageInfo: { hasNextPage: false, endCursor: null } },
+          },
+        },
+      },
+    ],
+  );
+  expect(await result).toMatchObject({ issues: [], pageInfo: { hasNextPage: false } });
+  expect(requests[0]?.variables).toMatchObject({
+    first: 25,
+    filter: { team: { key: { eq: "NOR" } } },
+  });
+  expect(requests[0]?.variables.filter).not.toHaveProperty("state");
+});
+
+it("rejects missing credentials and invalid page sizes without making a request", async () => {
+  const missing = run((tracker) => tracker.listAssigned({}), [], {});
+  await expect(missing.result).rejects.toThrow("LINEAR_API_KEY");
+  expect(missing.requests).toHaveLength(0);
+  const invalid = run((tracker) => tracker.listAssigned({ first: 51 }), []);
+  await expect(invalid.result).rejects.toThrow("1-50");
+  expect(invalid.requests).toHaveLength(0);
+});
+
+it("reports GraphQL errors and refuses incomplete pagination metadata", async () => {
+  const failed = run(
+    (tracker) => tracker.listAssigned({}),
+    [{ errors: [{ message: "Forbidden" }] }],
+  );
+  await expect(failed.result).rejects.toThrow("TRACKER_UNAVAILABLE");
+  const incomplete = run(
+    (tracker) => tracker.listAssigned({}),
+    [
+      {
+        data: {
+          viewer: {
+            id: "viewer",
+            name: "Fixture",
+            assignedIssues: { nodes: [], pageInfo: { hasNextPage: true, endCursor: null } },
+          },
+        },
+      },
+    ],
+  );
+  await expect(incomplete.result).rejects.toThrow("TRACKER_INCOMPLETE");
+});
diff --git a/apps/server/src/nornic/LinearTracker.ts b/apps/server/src/nornic/LinearTracker.ts
new file mode 100644
index 0000000000..0c73cb0870
--- /dev/null
+++ b/apps/server/src/nornic/LinearTracker.ts
@@ -0,0 +1,199 @@
+import * as Config from "effect/Config";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as Schema from "effect/Schema";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+
+const Named = Schema.Struct({ id: Schema.String, name: Schema.String });
+export const Issue = Schema.Struct({
+  id: Schema.String,
+  identifier: Schema.String,
+  title: Schema.String,
+  description: Schema.NullOr(Schema.String),
+  url: Schema.String,
+  updatedAt: Schema.String,
+  priority: Schema.Number,
+  team: Schema.Struct({ id: Schema.String, key: Schema.String }),
+  project: Schema.NullOr(Named),
+  projectMilestone: Schema.NullOr(Named),
+  assignee: Schema.NullOr(Named),
+  state: Schema.Struct({ id: Schema.String, name: Schema.String, type: Schema.String }),
+  labels: Schema.Struct({ nodes: Schema.Array(Named) }),
+});
+const AssignedIssue = Schema.Struct({
+  id: Schema.String,
+  identifier: Schema.String,
+  title: Schema.String,
+  url: Schema.String,
+  updatedAt: Schema.String,
+  priority: Schema.Number,
+  team: Schema.Struct({ id: Schema.String, key: Schema.String }),
+  assignee: Schema.NullOr(Named),
+  state: Schema.Struct({ id: Schema.String, name: Schema.String, type: Schema.String }),
+});
+const Assigned = Schema.Struct({
+  viewer: Schema.Struct({
+    id: Schema.String,
+    name: Schema.String,
+    assignedIssues: Schema.Struct({
+      nodes: Schema.Array(AssignedIssue),
+      pageInfo: Schema.Struct({
+        hasNextPage: Schema.Boolean,
+        endCursor: Schema.NullOr(Schema.String),
+      }),
+    }),
+  }),
+});
+export interface AssignedOptions {
+  readonly after?: string | undefined;
+  readonly first?: number | undefined;
+  readonly includeCompleted?: boolean | undefined;
+}
+const decodeAssigned = Schema.decodeUnknownEffect(Assigned);
+const decodeIssue = Schema.decodeUnknownEffect(Schema.Struct({ issue: Schema.NullOr(Issue) }));
+const Result = Schema.Struct({
+  data: Schema.optionalKey(Schema.NullOr(Schema.Unknown)),
+  errors: Schema.optionalKey(Schema.Array(Schema.Struct({ message: Schema.String }))),
+});
+const decodeResult = Schema.decodeUnknownEffect(Result);
+export class LinearTrackerError extends Schema.TaggedError<LinearTrackerError>()(
+  "LinearTrackerError",
+  { reason: Schema.String },
+) {
+  override get message() {
+    return this.reason;
+  }
+}
+export class LinearTracker extends Context.Service<
+  LinearTracker,
+  {
+    readonly getIssue: (id: string) => Effect.Effect<typeof Issue.Type, LinearTrackerError>;
+    readonly listAssigned: (options: AssignedOptions) => Effect.Effect<
+      {
+        readonly viewer: typeof Named.Type;
+        readonly issues: ReadonlyArray<typeof AssignedIssue.Type>;
+        readonly pageInfo: typeof Assigned.Type.viewer.assignedIssues.pageInfo;
+      },
+      LinearTrackerError
+    >;
+  }
+>()("t3/nornic/LinearTracker") {}
+
+const isTrackerError = Schema.is(LinearTrackerError);
+export const make = Effect.gen(function* () {
+  const client = yield* HttpClient.HttpClient;
+  const apiKey = yield* Config.Redacted("LINEAR_API_KEY").pipe(
+    Config.withDefault(Redacted.make("")),
+  );
+  const team = yield* Config.String("NORNIC_LINEAR_TEAM").pipe(Config.withDefault("NOR"));
+  const request = Effect.fn("LinearTracker.request")(
+    function* (query: string, variables: Record<string, unknown>) {
+      if (!Redacted.value(apiKey))
+        return yield* new LinearTrackerError({
+          reason:
+            "TRACKER_UNAVAILABLE: set LINEAR_API_KEY in the private swarm env file, then restart T3.",
+        });
+      const req = yield* HttpClientRequest.post("https://api.linear.app/graphql").pipe(
+        HttpClientRequest.setHeader("Authorization", Redacted.value(apiKey)),
+        HttpClientRequest.bodyJson({ query, variables }),
+      );
+      const response = yield* client.execute(req);
+      const result = yield* response.json.pipe(Effect.flatMap(decodeResult));
+      if (response.status !== 200 || result.errors?.length || result.data == null)
+        return yield* new LinearTrackerError({
+          reason:
+            "TRACKER_UNAVAILABLE: Linear read failed; check API-key permissions and connectivity. No external mutation occurred.",
+        });
+      return result.data;
+    },
+    Effect.timeout("30 seconds"),
+    Effect.mapError((cause) =>
+      isTrackerError(cause)
+        ? cause
+        : new LinearTrackerError({
+            reason:
+              "TRACKER_UNAVAILABLE: request failed or timed out; no external mutation occurred.",
+          }),
+    ),
+  );
+  const getIssue = Effect.fn("LinearTracker.getIssue")(function* (id: string) {
+    if (!/^(?:[A-Z][A-Z0-9]*-\d+|[a-f0-9-]{36})$/.test(id))
+      return yield* new LinearTrackerError({
+        reason:
+          "Use a Linear issue identifier or UUID. For my assigned issues use linear.assigned without issueId.",
+      });
+    const result = yield* request(
+      "query HarnessIssue($id: String!) { issue(id: $id) { id identifier title description url updatedAt priority team { id key } project { id name } projectMilestone { id name } assignee { id name } state { id name type } labels { nodes { id name } } } }",
+      { id },
+    ).pipe(
+      Effect.flatMap(decodeIssue),
+      Effect.mapError((cause) =>
+        isTrackerError(cause)
+          ? cause
+          : new LinearTrackerError({ reason: "TRACKER_UNAVAILABLE: malformed issue response." }),
+      ),
+    );
+    const issue = result.issue;
+    if (!issue)
+      return yield* new LinearTrackerError({
+        reason: "TRACKER_UNAVAILABLE: issue not found or not accessible.",
+      });
+    if (issue.team.key !== team)
+      return yield* new LinearTrackerError({
+        reason: "TRACKER_MAPPING_INVALID: issue belongs to another team.",
+      });
+    if (issue.labels.nodes.length >= 50)
+      return yield* new LinearTrackerError({
+        reason: "TRACKER_INCOMPLETE: label pagination must be resolved before intake.",
+      });
+    return issue;
+  });
+  const listAssigned = Effect.fn("LinearTracker.listAssigned")(function* (
+    options: AssignedOptions,
+  ) {
+    const first = options.first ?? 25;
+    if (!Number.isInteger(first) || first < 1 || first > 50 || (options.after?.length ?? 0) > 1024)
+      return yield* new LinearTrackerError({
+        reason: "Use a page size of 1-50 and a cursor of at most 1024 characters.",
+      });
+    const filter = {
+      team: { key: { eq: team } },
+      ...(!options.includeCompleted ? { state: { type: { nin: ["completed", "canceled"] } } } : {}),
+    };
+    const result = yield* request(
+      "query HarnessAssigned($first: Int!, $after: String, $filter: IssueFilter!) { viewer { id name assignedIssues(first: $first, after: $after, filter: $filter) { nodes { id identifier title url updatedAt priority team { id key } assignee { id name } state { id name type } } pageInfo { hasNextPage endCursor } } } }",
+      { first, after: options.after ?? null, filter },
+    ).pipe(
+      Effect.flatMap(decodeAssigned),
+      Effect.mapError((cause) =>
+        isTrackerError(cause)
+          ? cause
+          : new LinearTrackerError({
+              reason: "TRACKER_UNAVAILABLE: malformed assignment response.",
+            }),
+      ),
+    );
+    const { assignedIssues, ...viewer } = result.viewer;
+    if (
+      assignedIssues.nodes.some(
+        (issue) => issue.team.key !== team || issue.assignee?.id !== viewer.id,
+      )
+    )
+      return yield* new LinearTrackerError({
+        reason:
+          "TRACKER_MAPPING_INVALID: assignments do not match the authenticated viewer and configured team.",
+      });
+    if (
+      assignedIssues.pageInfo.hasNextPage &&
+      (!assignedIssues.pageInfo.endCursor || assignedIssues.pageInfo.endCursor === options.after)
+    )
+      return yield* new LinearTrackerError({
+        reason: "TRACKER_INCOMPLETE: Linear returned a non-advancing assignment cursor.",
+      });
+    return { viewer, issues: assignedIssues.nodes, pageInfo: assignedIssues.pageInfo };
+  });
+  return LinearTracker.of({ getIssue, listAssigned });
+});
+export const layer = Layer.effect(LinearTracker, make).pipe(Layer.provide(FetchHttpClient.layer));
