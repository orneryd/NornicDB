+  expect(requiresUserStartedSession("gpt-6-astra")).toBe(true);
+  expect(requiresUserStartedSession("gpt-6-astra-preview")).toBe(true);
+  expect(requiresUserStartedSession("gpt-6.1-sol")).toBe(false);
+  expect(requiresUserStartedSession("gpt-6-sol")).toBe(false);
+});
