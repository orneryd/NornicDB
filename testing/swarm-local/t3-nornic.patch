+import * as Effect from "effect/Effect";
+import * as NornicMcp from "../../../nornic/NornicMcp.ts";
+import * as McpToolAccess from "../../McpToolAccess.ts";
+import { NornicGraphToolkit } from "./graphTools.ts";
+export const layer = McpToolAccess.toLayer(NornicGraphToolkit, {
+  nornic_store: McpToolAccess.actsAsCaller((args) =>
+    Effect.gen(function* () {
+      const service = yield* NornicMcp.NornicMcp;
+      return yield* service.call("store", args);
+    }),
+  ),
+  nornic_recall: McpToolAccess.readsAsCaller((args) =>
+    Effect.gen(function* () {
+      const service = yield* NornicMcp.NornicMcp;
+      return yield* service.call("recall", args);
+    }),
+  ),
+  nornic_discover: McpToolAccess.readsAsCaller((args) =>
+    Effect.gen(function* () {
+      const service = yield* NornicMcp.NornicMcp;
+      return yield* service.call("discover", args);
+    }),
+  ),
+  nornic_link: McpToolAccess.actsAsCaller((args) =>
+    Effect.gen(function* () {
+      const service = yield* NornicMcp.NornicMcp;
+      return yield* service.call("link", args);
+    }),
+  ),
+  nornic_tasks: McpToolAccess.actsAsCaller((args) =>
+    Effect.gen(function* () {
+      const service = yield* NornicMcp.NornicMcp;
+      return yield* service.call("tasks", args);
+    }),
+  ),
+});
diff --git a/apps/server/src/mcp/toolkits/nornic/graphTools.ts b/apps/server/src/mcp/toolkits/nornic/graphTools.ts
