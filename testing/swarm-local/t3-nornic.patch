diff --git a/apps/server/src/nornic/NornicMcp.ts b/apps/server/src/nornic/NornicMcp.ts
new file mode 100644
index 0000000000..7a8d7dc2f5
--- /dev/null
+++ b/apps/server/src/nornic/NornicMcp.ts
@@ -0,0 +1,79 @@
+import * as Config from "effect/Config";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+import { OrchestratorMcpFailure } from "@t3tools/contracts";
+import * as NornicAuth from "./NornicAuth.ts";
+
+const decodeReply = Schema.decodeUnknownEffect(
+  Schema.Struct({
+    result: Schema.optional(Schema.Unknown),
+    error: Schema.optional(Schema.Struct({ code: Schema.Number, message: Schema.String })),
+  }),
+);
+export class NornicMcp extends Context.Service<
+  NornicMcp,
+  {
+    readonly call: (
+      name: "store" | "recall" | "discover" | "link" | "tasks",
+      args: Readonly<Record<string, unknown>>,
+    ) => Effect.Effect<unknown, OrchestratorMcpFailure>;
+  }
+>()("t3/nornic/NornicMcp") {}
+export const make = Effect.gen(function* () {
+  const client = yield* HttpClient.HttpClient;
+  const authenticate = yield* NornicAuth.request;
+  const origin = yield* Config.String("NORNICDB_WORKFLOW_URL").pipe(
+    Config.withDefault("http://127.0.0.1:7474"),
+  );
+  const database = yield* Config.String("NORNIC_CODE_DATABASE").pipe(
+    Config.withDefault("nornicdbcode"),
+  );
+  const call = Effect.fn("NornicMcp.call")(
+    function* (
+      name: "store" | "recall" | "discover" | "link" | "tasks",
+      args: Readonly<Record<string, unknown>>,
+    ) {
+      const request = yield* HttpClientRequest.post(
+        `${origin}/mcp/${encodeURIComponent(database)}`,
+      ).pipe(
+        HttpClientRequest.bodyJson({
+          jsonrpc: "2.0",
+          id: 1,
+          method: "tools/call",
+          params: { name, arguments: { ...args, database } },
+        }),
+      );
+      const response = yield* client.execute(authenticate(request));
+      if (response.status !== 200)
+        return yield* new OrchestratorMcpFailure({
+          code: "orchestration_error",
+          message: `NornicDB MCP HTTP ${response.status}`,
+        });
+      const reply = yield* response.json.pipe(Effect.flatMap(decodeReply));
+      if (reply.error)
+        return yield* new OrchestratorMcpFailure({
+          code: "orchestration_error",
+          message: `NornicDB MCP ${reply.error.code}: ${reply.error.message}`,
+        });
+      if (reply.result === undefined)
+        return yield* new OrchestratorMcpFailure({
+          code: "orchestration_error",
+          message: "NornicDB MCP returned no result",
+        });
+      return reply.result;
+    },
+    Effect.timeout("30 seconds"),
+    Effect.mapError(
+      (cause) =>
+        new OrchestratorMcpFailure({
+          code: "orchestration_error",
+          message: cause instanceof Error ? cause.message : "NornicDB MCP call failed",
+        }),
+    ),
+  );
+  return NornicMcp.of({ call });
+});
+export const layer = Layer.effect(NornicMcp, make).pipe(Layer.provide(FetchHttpClient.layer));
diff --git a/apps/server/src/nornic/NornicStore.integration.test.ts b/apps/server/src/nornic/NornicStore.integration.test.ts
new file mode 100644
index 0000000000..06c688c660
--- /dev/null
+++ b/apps/server/src/nornic/NornicStore.integration.test.ts
@@ -0,0 +1,143 @@
+import { describe, expect, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as Clock from "effect/Clock";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+import * as NornicStore from "./NornicStore.ts";
+import * as NornicAuth from "./NornicAuth.ts";
+import { WorkflowState } from "./workflowSchema.ts";
+import { emptyState, transition, type Owner } from "./workflowState.ts";
+
+const codec = Schema.fromJsonString(WorkflowState);
+const encode = Schema.encodeEffect(codec);
+const decode = Schema.decodeUnknownEffect(codec);
+
+describe.runIf(process.env.NORNICDB_LIVE_TEST === "1")(
+  "live NornicDB persistence (requires NORNICDB_LIVE_TEST=1)",
+  () => {
+    it.live("reloads claims, detects contention and expiry, and rejects stale writers", () =>
+      Effect.gen(function* () {
+        const key = `integration-test-${yield* Clock.currentTimeMillis}`;
+        const alice: Owner = {
+          environmentId: "test",
+          threadId: "alice",
+          providerSessionId: "a",
+          providerInstanceId: "pi",
+        };
+        const bob: Owner = { ...alice, threadId: "bob", providerSessionId: "b" };
+        const store = yield* NornicStore.NornicStore;
+        try {
+          expect(yield* store.load(key)).toBeNull();
+          let state = emptyState();
+          for (const [owner, taskId] of [
+            [alice, "a"],
+            [bob, "b"],
+          ] as const) {
+            state = transition(
+              state,
+              owner,
+              {
+                operation: "task.create",
+                requestId: `create-${taskId}`,
+                taskId,
+                title: taskId,
+                acceptanceCriteria: ["tests pass"],
+              },
+              1000,
+            ).state;
+            state = transition(
+              state,
+              owner,
+              {
+                operation: "plan.put",
+                requestId: `plan-${taskId}`,
+                taskId,
+                expectedVersion: 1,
+                steps: ["edit"],
+                validation: ["test"],
+                resources: ["pkg/a.go"],
+              },
+              1000,
+            ).state;
+          }
+          state = transition(
+            state,
+            alice,
+            {
+              operation: "claim.acquire",
+              requestId: "claim-a",
+              taskId: "a",
+              resources: ["pkg/a.go"],
+              reason: "test",
+              ttlSeconds: 30,
+            },
+            1000,
+          ).state;
+          const snapshot = yield* encode(state);
+          yield* store.save(key, 0, state.version, snapshot);
+          const persisted = yield* store.load(key);
+          expect(persisted).toBe(snapshot);
+          const restored = yield* decode(persisted);
+          expect(
+            transition(
+              restored,
+              bob,
+              {
+                operation: "claim.acquire",
+                requestId: "claim-b",
+                taskId: "b",
+                resources: ["pkg/a.go"],
+                reason: "test",
+              },
+              1001,
+            ).response.code,
+          ).toBe("CLAIM_CONFLICT");
+          expect(
+            transition(
+              restored,
+              bob,
+              {
+                operation: "claim.acquire",
+                requestId: "claim-b-expired",
+                taskId: "b",
+                resources: ["pkg/a.go"],
+                reason: "test",
+              },
+              31001,
+            ).response.ok,
+          ).toBe(true);
+          expect((yield* store.save(key, 0, state.version + 1, "{}").pipe(Effect.exit))._tag).toBe(
+            "Failure",
+          );
+          expect(yield* store.load(key)).toBe(snapshot);
+        } finally {
+          const client = yield* HttpClient.HttpClient;
+          const authenticate = yield* NornicAuth.request;
+          const request = yield* HttpClientRequest.post(
+            `${process.env.NORNICDB_WORKFLOW_URL ?? "http://127.0.0.1:7474"}/db/${process.env.NORNICDB_WORKFLOW_DATABASE ?? "t3workflow"}/tx/commit`,
+          ).pipe(
+            HttpClientRequest.bodyJson({
+              statements: [
+                {
+                  statement: "MATCH (n:SwarmWorkflow {key: $key}) DETACH DELETE n",
+                  parameters: { key },
+                },
+              ],
+            }),
+          );
+          const response = yield* client.execute(authenticate(request));
+          yield* response.json;
+        }
+      }).pipe(
+        Effect.provide(Layer.merge(NornicStore.layer, FetchHttpClient.layer)),
+        Effect.provide(
+          ConfigProvider.layer(
+            ConfigProvider.fromEnv({ env: process.env as Record<string, string> }),
+          ),
+        ),
+      ),
+    );
+  },
+);
diff --git a/apps/server/src/nornic/NornicStore.ts b/apps/server/src/nornic/NornicStore.ts
new file mode 100644
index 0000000000..5108be92cf
--- /dev/null
+++ b/apps/server/src/nornic/NornicStore.ts
@@ -0,0 +1,94 @@
+import * as Config from "effect/Config";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+import * as NornicAuth from "./NornicAuth.ts";
+
+export class NornicStoreError extends Schema.TaggedError<NornicStoreError>()("NornicStoreError", {
+  operation: Schema.String,
+  cause: Schema.Defect(),
+}) {
+  override get message() {
+    return `NornicDB workflow storage failed during ${this.operation}.`;
+  }
+}
+
+const Result = Schema.Struct({
+  results: Schema.Array(
+    Schema.Struct({ data: Schema.Array(Schema.Struct({ row: Schema.Array(Schema.Unknown) })) }),
+  ),
+  errors: Schema.Array(Schema.Struct({ code: Schema.String, message: Schema.String })),
+});
+
+export class NornicStore extends Context.Service<
+  NornicStore,
+  {
+    readonly load: (key: string) => Effect.Effect<string | null, NornicStoreError>;
+    readonly save: (
+      key: string,
+      expectedVersion: number,
+      version: number,
+      snapshot: string,
+    ) => Effect.Effect<void, NornicStoreError>;
+  }
+>()("t3/nornic/NornicStore") {}
+
+const make = Effect.gen(function* () {
+  const origin = yield* Config.String("NORNICDB_WORKFLOW_URL").pipe(
+    Config.withDefault("http://127.0.0.1:7474"),
+  );
+  const database = yield* Config.String("NORNICDB_WORKFLOW_DATABASE").pipe(
+    Config.withDefault("t3workflow"),
+  );
+  const client = yield* HttpClient.HttpClient;
+  const authenticate = yield* NornicAuth.request;
+  const query = Effect.fn("NornicStore.query")(
+    function* (statement: string, parameters: Record<string, unknown>) {
+      const request = yield* HttpClientRequest.post(
+        `${origin}/db/${encodeURIComponent(database)}/tx/commit`,
+      ).pipe(HttpClientRequest.bodyJson({ statements: [{ statement, parameters }] }));
+      const response = yield* client.execute(authenticate(request));
+      const result = yield* response.json.pipe(Effect.flatMap(Schema.decodeUnknownEffect(Result)));
+      if (response.status !== 200 || result.errors.length)
+        return yield* new NornicStoreError({
+          operation: "database-response",
+          cause: { status: response.status, errors: result.errors },
+        });
+      return result.results[0]?.data[0]?.row[0];
+    },
+    Effect.timeout("15 seconds"),
+    Effect.mapError((cause) => new NornicStoreError({ operation: "query", cause })),
+  );
+
+  const load = Effect.fn("NornicStore.load")(function* (key: string) {
+    const value = yield* query("MATCH (n:SwarmWorkflow {key: $key}) RETURN n.snapshot", { key });
+    if (value === undefined || value === null) return null;
+    if (typeof value !== "string")
+      return yield* new NornicStoreError({
+        operation: "decode",
+        cause: "snapshot is not a string",
+      });
+    return value;
+  });
+  const save = Effect.fn("NornicStore.save")(function* (
+    key: string,
+    expectedVersion: number,
+    version: number,
+    snapshot: string,
+  ) {
+    const stored = yield* query(
+      "MERGE (n:SwarmWorkflow {key: $key}) ON CREATE SET n.version = 0 WITH n WHERE n.version = $expected SET n.version = $version, n.snapshot = $snapshot RETURN n.version",
+      { key, expected: expectedVersion, version, snapshot },
+    );
+    if (stored !== version)
+      return yield* new NornicStoreError({
+        operation: "compare-and-set",
+        cause: { expectedVersion, stored },
+      });
+  });
+  return NornicStore.of({ load, save });
+});
+
+export const layer = Layer.effect(NornicStore, make).pipe(Layer.provide(FetchHttpClient.layer));
