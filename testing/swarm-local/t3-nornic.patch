+import * as Schema from "effect/Schema";
+import { NornicWorkflowResponse } from "@t3tools/contracts";
+import { Issue } from "./LinearTracker.ts";
+
+const Owner = Schema.Struct({
+  environmentId: Schema.String,
+  threadId: Schema.String,
+  providerSessionId: Schema.String,
+  providerInstanceId: Schema.String,
+});
+const Plan = Schema.Struct({
+  resources: Schema.Array(Schema.String),
+  steps: Schema.Array(Schema.String),
+  validation: Schema.Array(Schema.String),
+});
+const Task = Schema.Struct({
+  linearIssue: Schema.optionalKey(Issue),
+  id: Schema.String,
+  title: Schema.String,
+  acceptanceCriteria: Schema.Array(Schema.String),
+  owner: Owner,
+  version: Schema.Int,
+  plan: Schema.optionalKey(Plan),
+  pendingWrite: Schema.optionalKey(
+    Schema.Struct({
+      requestId: Schema.String,
+      path: Schema.String,
+      beforeHash: Schema.String,
+      afterHash: Schema.String,
+      generation: Schema.Int,
+    }),
+  ),
+  writes: Schema.optionalKey(
+    Schema.Record(
+      Schema.String,
+      Schema.Struct({ path: Schema.String, beforeHash: Schema.String, afterHash: Schema.String }),
+    ),
+  ),
+  duplicateReceipt: Schema.optionalKey(
+    Schema.Struct({
+      passed: Schema.Boolean,
+      treeHash: Schema.String,
+      exitCode: Schema.NullOr(Schema.Number),
+      advice: Schema.String,
+    }),
+  ),
+});
+const Claim = Schema.Struct({
+  taskId: Schema.String,
+  owner: Owner,
+  resources: Schema.Array(Schema.String),
+  generation: Schema.Int,
+  expiresAt: Schema.Number,
+  reason: Schema.String,
+});
+export const WorkflowState = Schema.Struct({
+  version: Schema.Int,
+  tasks: Schema.Record(Schema.String, Task),
+  claims: Schema.Record(Schema.String, Claim),
+  receipts: Schema.Record(
+    Schema.String,
+    Schema.Struct({ digest: Schema.String, response: NornicWorkflowResponse }),
+  ),
+});
