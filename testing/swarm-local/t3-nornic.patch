@@ -0,0 +1,326 @@
+import * as Schema from "effect/Schema";
+
+export interface Owner {
+  readonly environmentId: string;
+  readonly threadId: string;
+  readonly providerSessionId: string;
+  readonly providerInstanceId: string;
+}
+interface Plan {
+  readonly resources: ReadonlyArray<string>;
+  readonly steps: ReadonlyArray<string>;
+  readonly validation: ReadonlyArray<string>;
+}
+interface Task {
+  readonly linearIssue?: typeof import("./LinearTracker.ts").Issue.Type;
+  readonly id: string;
+  readonly title: string;
+  readonly acceptanceCriteria: ReadonlyArray<string>;
+  readonly owner: Owner;
+  readonly version: number;
+  readonly plan?: Plan;
+  readonly pendingWrite?: {
+    readonly requestId: string;
+    readonly path: string;
+    readonly beforeHash: string;
+    readonly afterHash: string;
+    readonly generation: number;
+  };
+  readonly writes?: Readonly<
+    Record<
+      string,
+      { readonly path: string; readonly beforeHash: string; readonly afterHash: string }
+    >
+  >;
+  readonly duplicateReceipt?: {
+    readonly passed: boolean;
+    readonly treeHash: string;
+    readonly exitCode: number | null;
+    readonly advice: string;
+  };
+}
+interface Claim {
+  readonly taskId: string;
+  readonly owner: Owner;
+  readonly resources: ReadonlyArray<string>;
+  readonly generation: number;
+  readonly expiresAt: number;
+  readonly reason: string;
+}
+export interface WorkflowResponse {
+  readonly ok: boolean;
+  readonly code: string;
+  readonly data: Readonly<Record<string, unknown>>;
+  readonly version: number;
+  readonly requestId: string;
+}
+export interface WorkflowState {
+  readonly version: number;
+  readonly tasks: Readonly<Record<string, Task>>;
+  readonly claims: Readonly<Record<string, Claim>>;
+  readonly receipts: Readonly<
+    Record<string, { readonly digest: string; readonly response: WorkflowResponse }>
+  >;
+}
+export interface WorkflowRequest {
+  readonly linearIssue?: typeof import("./LinearTracker.ts").Issue.Type;
+  readonly operation: string;
+  readonly requestId: string;
+  readonly taskId?: string;
+  readonly expectedVersion?: number;
+  readonly title?: string;
+  readonly acceptanceCriteria?: ReadonlyArray<string>;
+  readonly steps?: ReadonlyArray<string>;
+  readonly validation?: ReadonlyArray<string>;
+  readonly resources?: ReadonlyArray<string>;
+  readonly reason?: string;
+  readonly generation?: number;
+  readonly ttlSeconds?: number;
+}
+
+export const emptyState = (): WorkflowState => ({
+  version: 0,
+  tasks: {},
+  claims: {},
+  receipts: {},
+});
+const sameOwner = (a: Owner, b: Owner) =>
+  a.environmentId === b.environmentId &&
+  a.threadId === b.threadId &&
+  a.providerSessionId === b.providerSessionId &&
+  a.providerInstanceId === b.providerInstanceId;
+const encode = Schema.encodeSync(Schema.fromJsonString(Schema.Unknown));
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === "object")
+    return Object.fromEntries(
+      Object.entries(value)
+        .sort(([a], [b]) => a.localeCompare(b))
+        .map(([key, item]) => [key, canonical(item)]),
+    );
+  return value;
+}
+const digest = (value: unknown): string => encode(canonical(value));
+
+function strings(value: ReadonlyArray<string> | undefined, field: string): ReadonlyArray<string> {
+  if (
+    !value?.length ||
+    value.length > 256 ||
+    value.some((item) => !item.trim() || item.length > 4096)
+  )
+    throw new Error(`${field} requires 1-256 nonempty bounded strings`);
+  return value;
+}
+function paths(value: ReadonlyArray<string> | undefined): ReadonlyArray<string> {
+  return [...new Set(strings(value, "resources"))].sort().map((item) => {
+    const name = item.endsWith("/") ? item.slice(0, -1) : item;
+    if (
+      !name ||
+      /[\\:\0]/.test(name) ||
+      name.startsWith("/") ||
+      name.split("/").some((part) => part === ".." || part === "." || !part)
+    )
+      throw new Error(
+        "resources must be canonical repository-relative paths; a trailing slash identifies a directory",
+      );
+    return item;
+  });
+}
+export const resourceContains = (scope: string, resource: string) =>
+  scope === resource || (scope.endsWith("/") && resource.startsWith(scope));
+const overlaps = (a: ReadonlyArray<string>, b: ReadonlyArray<string>) =>
+  a.some((left) =>
+    b.some((right) => resourceContains(left, right) || resourceContains(right, left)),
+  );
+
+// This transition records coordination only. It never grants a filesystem
+// permit; strict admission remains unavailable until the executor is qualified.
+export function transition(
+  state: WorkflowState,
+  owner: Owner,
+  request: WorkflowRequest,
+  now: number,
+): { readonly state: WorkflowState; readonly response: WorkflowResponse } {
+  if (!request.requestId || request.requestId.length > 256)
+    throw new Error("requestId is required and bounded to 256 characters");
+  const key = encode([owner, request.operation, request.requestId]);
+  const { linearIssue: _trustedIssue, ...clientRequest } = request;
+  const inputHash = digest(clientRequest);
+  const receipt = state.receipts[key];
+  const response = (
+    code: string,
+    data: Readonly<Record<string, unknown>> = {},
+    version = state.version,
+  ): WorkflowResponse => ({ ok: code === "OK", code, data, version, requestId: request.requestId });
+  if (receipt)
+    return {
+      state,
+      response: receipt.digest === inputHash ? receipt.response : response("IDEMPOTENCY_MISMATCH"),
+    };
+  if (request.operation === "capabilities")
+    return {
+      state,
+      response: response("OK", {
+        strictEnforcementReady: false,
+        operations: [
+          "intent.classify",
+          "intent.route",
+          "task.create",
+          "task.get",
+          "plan.put",
+          "claim.acquire",
+          "claim.release",
+          "session.heartbeat",
+          "workflow.next",
+          "file.read",
+          "file.write",
+        ],
+        unavailable: [
+          "constrained executor",
+          "independent evidence",
+          "Linear projection",
+          "automatic phase progression",
+        ],
+      }),
+    };
+  const tasks = { ...state.tasks };
+  const claims = { ...state.claims };
+  const taskId = request.taskId;
+  if (!taskId || taskId.length > 256)
+    throw new Error("taskId is required and bounded to 256 characters");
+  const task = tasks[taskId];
+  let result: WorkflowResponse;
+  const nextVersion = state.version + 1;
+  if (request.operation === "task.create") {
+    if (task) result = response("VERSION_CONFLICT", { task });
+    else {
+      if (!request.title?.trim() || request.title.length > 4096)
+        throw new Error("title is required and bounded to 4096 characters");
+      const created: Task = {
+        id: taskId,
+        title: request.title,
+        acceptanceCriteria: strings(request.acceptanceCriteria, "acceptanceCriteria"),
+        owner,
+        version: 1,
+      };
+      tasks[taskId] = created;
+      result = response("OK", { task: created }, nextVersion);
+    }
+  } else if (!task) result = response("TASK_NOT_FOUND");
+  else if (!sameOwner(task.owner, owner))
+    result = response("SESSION_MISMATCH", { owner: task.owner });
+  else if (request.operation === "task.get" || request.operation === "workflow.next") {
+    const claim = claims[taskId];
+    return {
+      state,
+      response: response("OK", {
+        task,
+        claim: claim && claim.expiresAt > now ? claim : null,
+        next: !task.plan
+          ? "plan.put"
+          : !claim || claim.expiresAt <= now
+            ? "claim.acquire"
+            : task.duplicateReceipt?.passed
+              ? "independent validation required"
+              : "file.read / file.write / workflow.validate",
+        strictEnforcementReady: false,
+      }),
+    };
+  } else if (task.pendingWrite) {
+    result = response("ACTION_UNRESOLVED", { action: task.pendingWrite });
+  } else if (request.operation === "linear.bind") {
+    const issue = request.linearIssue;
+    if (request.expectedVersion !== task.version)
+      result = response("VERSION_CONFLICT", { currentVersion: task.version });
+    else if (!issue?.description?.trim()) result = response("TRACKER_SCOPE_MISSING");
+    else if (task.linearIssue && task.linearIssue.id !== issue.id)
+      result = response("TRACKER_CONFLICT", {
+        reason: "A task cannot silently change its canonical Linear outcome.",
+      });
+    else {
+      const { plan: _plan, duplicateReceipt: _receipt, ...base } = task;
+      const updated = { ...base, version: task.version + 1, linearIssue: issue };
+      tasks[taskId] = updated;
+      delete claims[taskId];
+      result = response(
+        "OK",
+        {
+          task: updated,
+          externalWritesEnabled: false,
+          next: "Plan against the exact bound Linear scope; no external fields were changed.",
+        },
+        nextVersion,
+      );
+    }
+  } else if (request.operation === "plan.put") {
+    if (request.expectedVersion !== task.version)
+      result = response("VERSION_CONFLICT", {
+        expectedVersion: request.expectedVersion,
+        currentVersion: task.version,
+      });
+    else {
+      const plan: Plan = {
+        resources: paths(request.resources),
+        steps: strings(request.steps, "steps"),
+        validation: strings(request.validation, "validation"),
+      };
+      tasks[taskId] = { ...task, version: task.version + 1, plan };
+      delete claims[taskId];
+      result = response("OK", { task: tasks[taskId] }, nextVersion);
+    }
+  } else if (request.operation === "claim.acquire") {
+    if (!task.plan) result = response("PHASE_PREREQUISITE", { next: "plan.put" });
+    else {
+      const resources = paths(request.resources);
+      const ttl = request.ttlSeconds ?? 120;
+      if (!Number.isInteger(ttl) || ttl < 30 || ttl > 600)
+        throw new Error("ttlSeconds must be an integer between 30 and 600");
+      if (!request.reason?.trim() || request.reason.length > 4096)
+        throw new Error("reason is required and bounded to 4096 characters");
+      if (
+        !resources.every((resource) =>
+          task.plan?.resources.some((scope) => resourceContains(scope, resource)),
+        )
+      )
+        result = response("PLAN_SCOPE_MISMATCH");
+      else {
+        const conflicts = Object.values(claims).filter(
+          (claim) =>
+            claim.taskId !== taskId &&
+            (claim.expiresAt > now || tasks[claim.taskId]?.pendingWrite !== undefined) &&
+            overlaps(claim.resources, resources),
+        );
+        if (conflicts.length) result = response("CLAIM_CONFLICT", { conflicts });
+        else {
+          const claim: Claim = {
+            taskId,
+            owner,
+            resources,
+            reason: request.reason,
+            expiresAt: now + ttl * 1000,
+            generation: nextVersion,
+          };
+          claims[taskId] = claim;
+          result = response("OK", { claim }, nextVersion);
+        }
+      }
+    }
+  } else if (request.operation === "claim.release" || request.operation === "session.heartbeat") {
+    const claim = claims[taskId];
+    if (!claim || claim.expiresAt <= now) result = response("CLAIM_EXPIRED");
+    else if (claim.generation !== request.generation)
+      result = response("STALE_GENERATION", { generation: claim.generation });
+    else {
+      if (request.operation === "claim.release") delete claims[taskId];
+      else claims[taskId] = { ...claim, expiresAt: now + 120_000 };
+      result = response("OK", { claim: claims[taskId] ?? null }, nextVersion);
+    }
+  } else throw new Error(`unsupported workflow operation: ${request.operation}`);
+  const next = {
+    version: nextVersion,
+    tasks,
+    claims,
+    receipts: { ...state.receipts, [key]: { digest: inputHash, response: result } },
+  };
+  return { state: next, response: result };
+}
