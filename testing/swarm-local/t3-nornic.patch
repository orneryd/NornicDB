@@ -0,0 +1,20 @@
+import type { OrchestrationV2ConversationMessage } from "@t3tools/contracts";
+
+type Provenance = Pick<
+  OrchestrationV2ConversationMessage,
+  "role" | "createdBy" | "creationSource"
+> & {
+  readonly delegatedCompletion?: unknown;
+  readonly notification?: unknown;
+};
+
+export function latestUserIntent<T extends Provenance>(messages: ReadonlyArray<T>): T | undefined {
+  return messages.findLast(
+    (message) =>
+      message.role === "user" &&
+      message.createdBy !== "system" &&
+      !message.delegatedCompletion &&
+      !message.notification &&
+      ["web", "mobile", "mcp"].includes(message.creationSource),
+  );
+}
