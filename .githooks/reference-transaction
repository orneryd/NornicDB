#!/usr/bin/env bash
# nornic-code-intelligence-managed
set -euo pipefail
if [ "${1:-}" != committed ] || [ "$(git config --bool --get codeIntelligence.enabled || true)" != true ]; then exit 0; fi
repo_root="$(git rev-parse --show-toplevel)"
runner="$repo_root/scripts/code-intelligence-hook.sh"
if [ ! -x "$runner" ]; then runner="$(git config --get codeIntelligence.hookRunner || true)"; fi
while read -r old new ref; do
    if [ "$ref" = refs/heads/main ] && [ "$new" != "$old" ] && [ -n "${new//0/}" ]; then
        if [ ! -x "$runner" ]; then echo "code-intelligence: runner missing; reinstall hooks." >&2; exit 1; fi
        "$runner" main-updated --revision "$new"
    fi
done
