CALL dbms.components() YIELD versions RETURN versions[0] AS version;
CREATE (:R73Hub),(:R73Target),(:R73Leaf);
MATCH (a:R73Hub),(x:R73Leaf) UNWIND range(1,20000) AS i CREATE (a)-[:R]->(x);
MATCH (a:R73Hub),(b:R73Target) CREATE (a)-[:R]->(b);
MATCH (a:R73Hub),(b:R73Target) RETURN exists((a)-[:R]->(b)) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN EXISTS { (a)-[:R]->(b) } AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN COUNT { (a)-[:R]->(b) } AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN size(COLLECT { MATCH (a)-[:R]->(b) RETURN 1 AS v }) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN size([(a)-[:R]->(b) | 1]) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN exists((b)<-[:R]-(a)) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN EXISTS { (b)<-[:R]-(a) } AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN COUNT { (b)<-[:R]-(a) } AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN size(COLLECT { MATCH (b)<-[:R]-(a) RETURN 1 AS v }) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN size([(b)<-[:R]-(a) | 1]) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN exists((a)-[:R]-(b)) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN EXISTS { (a)-[:R]-(b) } AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN COUNT { (a)-[:R]-(b) } AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN size(COLLECT { MATCH (a)-[:R]-(b) RETURN 1 AS v }) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN size([(a)-[:R]-(b) | 1]) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN exists((a)-[:R*1..1]->(b)) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN EXISTS { (a)-[:R*1..1]->(b) } AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN COUNT { (a)-[:R*1..1]->(b) } AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN size(COLLECT { MATCH (a)-[:R*1..1]->(b) RETURN 1 AS v }) AS found;
MATCH (a:R73Hub),(b:R73Target) RETURN size([(a)-[:R*1..1]->(b) | 1]) AS found;
