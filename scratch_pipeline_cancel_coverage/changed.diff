diff --git a/pkg/cypher/parameter_cancellation.go b/pkg/cypher/parameter_cancellation.go
new file mode 100644
index 000000000..9ac06889e
--- /dev/null
+++ b/pkg/cypher/parameter_cancellation.go
@@ -0,0 +1,68 @@
+package cypher
+
+import "context"
+
+func parameterCancellationForContext(ctx context.Context) *pipelineCancellation {
+	if ctx.Done() == nil {
+		return nil
+	}
+	return pipelineCancellationForContext(ctx)
+}
+
+func copyParameterListWithCancellation(values []interface{}, probe *pipelineCancellation) []interface{} {
+	if probe != nil && !probe.check() {
+		return nil
+	}
+	if len(values) > pipelineCancellationInterval && probe != nil && !probe.poll() {
+		return nil
+	}
+	return appendPipelineItems(make([]interface{}, 0), values, probe)
+}
+
+// The external parameter representation remains a native Go map. Its key
+// hashing and allocation are runtime boundaries; every application-controlled
+// scan borrows the statement probe. Generated alias keys have bounded length.
+// Copy lazily so a statement without a bound quoted parameter keeps its map.
+func bindQuotedQueryParametersWithCancellation(names *quotedVariableNames, params map[string]interface{}, probe *pipelineCancellation) map[string]interface{} {
+	if probe == nil {
+		return names.parameterValues(params)
+	}
+	var bound map[string]interface{}
+	lookup := func(name string) (interface{}, bool) {
+		for key, value := range params {
+			if !probe.check() {
+				return nil, false
+			}
+			if comparePipelineStrings(key, name, probe) == 0 {
+				return value, probe.err == nil
+			}
+			if probe.err != nil {
+				return nil, false
+			}
+		}
+		return nil, false
+	}
+	bind := func(name string, value interface{}) bool {
+		if bound == nil {
+			bound = make(map[string]interface{}, len(params)+len(names.parameterBindings))
+			for key, original := range params {
+				if !probe.check() {
+					return false
+				}
+				bound[key] = original
+			}
+		}
+		if !probe.check() {
+			return false
+		}
+		bound[name] = value
+		return true
+	}
+	if !names.bindParameterValuesWithCancellation(lookup, bind, probe) {
+		return nil
+	}
+	if bound != nil {
+		return bound
+	}
+	return params
+}
diff --git a/pkg/cypher/parameter_literals_cancellation.go b/pkg/cypher/parameter_literals_cancellation.go
new file mode 100644
index 000000000..dae44670a
--- /dev/null
+++ b/pkg/cypher/parameter_literals_cancellation.go
@@ -0,0 +1,95 @@
+package cypher
+
+import (
+	"context"
+	"fmt"
+	"strings"
+)
+
+// Substitution borrows the statement's probe; callers must propagate its error
+// before passing partial source to another reader or procedure handler.
+func (e *StorageExecutor) substituteParamsWithContext(ctx context.Context, query string, params map[string]interface{}) (string, error) {
+	probe := parameterCancellationForContext(ctx)
+	query = e.substituteParamsExceptWithCancellation(query, params, nil, probe)
+	if probe != nil {
+		return query, probe.err
+	}
+	return query, nil
+}
+
+func parameterListLiteral[T any](values []T, literal func(T) string, probe *pipelineCancellation) string {
+	parts := make([]string, 0, pipelineInitialCapacity(len(values), probe))
+	for _, value := range values {
+		if probe != nil && !probe.check() {
+			return ""
+		}
+		part := literal(value)
+		if probe != nil && probe.err != nil {
+			return ""
+		}
+		parts = appendPipelineItem(parts, part, probe)
+		if probe != nil && probe.err != nil {
+			return ""
+		}
+	}
+	return parameterDelimitedLiteral("[", parts, "]", probe)
+}
+
+func parameterDelimitedLiteral(open string, parts []string, close string, probe *pipelineCancellation) string {
+	if probe == nil {
+		return open + strings.Join(parts, ", ") + close
+	}
+	var out strings.Builder
+	if !appendPipelineString(&out, open, probe) || !appendPipelineString(&out, joinPipelineStrings(parts, ", ", probe), probe) || !appendPipelineString(&out, close, probe) {
+		return ""
+	}
+	return out.String()
+}
+
+func parameterMapEntry(key, value string, probe *pipelineCancellation) string {
+	if probe == nil {
+		return fmt.Sprintf("%s: %s", key, value)
+	}
+	return concatPipelineStrings(concatPipelineStrings(key, ": ", probe), value, probe)
+}
+
+func quoteCypherStringLiteralWithCancellation(raw string, probe *pipelineCancellation) string {
+	if probe == nil {
+		return "'" + escapeCypherStringLiteral(raw) + "'"
+	}
+	var out strings.Builder
+	if !appendPipelineByte(&out, '\'', probe) {
+		return ""
+	}
+	for start := 0; start < len(raw); {
+		offset := indexAnyWithCancellation(raw[start:], "'\\", probe)
+		if probe.err != nil {
+			return ""
+		}
+		if offset < 0 {
+			if !appendPipelineString(&out, raw[start:], probe) {
+				return ""
+			}
+			break
+		}
+		end := start + offset
+		if !appendPipelineString(&out, raw[start:end], probe) || !appendPipelineByte(&out, raw[end], probe) || !appendPipelineByte(&out, raw[end], probe) {
+			return ""
+		}
+		start = end + 1
+	}
+	if !appendPipelineByte(&out, '\'', probe) {
+		return ""
+	}
+	return out.String()
+}
+
+func formatCypherMapKeyWithCancellation(key string, probe *pipelineCancellation) string {
+	if isSimpleCypherMapKeyWithCancellation(key, probe) {
+		return key
+	}
+	if probe != nil && probe.err != nil {
+		return ""
+	}
+	return quoteCypherStringLiteralWithCancellation(key, probe)
+}
