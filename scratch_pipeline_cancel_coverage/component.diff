+func callSubqueryBatchSizeWithCancellation(text string, probe *pipelineCancellation) (int, bool) {
+	if probe == nil {
+		value, err := strconv.Atoi(text)
+		return value, err == nil && value > 0
+	}
+	if len(text) > 0 && text[0] == '+' {
