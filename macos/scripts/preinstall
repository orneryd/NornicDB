#!/bin/bash
# Stop installed services before replacing executable payloads. Never remove data,
# models, configuration, credentials, or startup settings.
set -euo pipefail
ACTUAL_USER="${USER}"
if [ "$ACTUAL_USER" = root ]; then
    ACTUAL_USER=$(ls -l /dev/console | awk '{print $3}')
fi
USER_HOME=$(eval echo ~$ACTUAL_USER)
USER_UID=$(id -u "$ACTUAL_USER")

# Unload both launch owners first so an old agent cannot respawn its app while
# the package replaces it. Explicit GUI targets work from the root installer.
for label in com.nornicdb.menubar com.nornicdb.server; do
    sudo -u "$ACTUAL_USER" launchctl bootout "gui/$USER_UID/$label" 2>/dev/null || true
done
for executable in NornicDB nornicdb; do
    pkill -TERM -u "$USER_UID" -x "$executable" 2>/dev/null || true
    for attempt in {1..100}; do
        if ! pgrep -u "$USER_UID" -x "$executable" >/dev/null; then break; fi
        sleep 0.1
    done
    if [ "$executable" = NornicDB ] && pgrep -u "$USER_UID" -x "$executable" >/dev/null; then
        pkill -KILL -u "$USER_UID" -x "$executable" 2>/dev/null || true
        for attempt in {1..20}; do
            if ! pgrep -u "$USER_UID" -x "$executable" >/dev/null; then break; fi
            sleep 0.1
        done
    fi
    if pgrep -u "$USER_UID" -x "$executable" >/dev/null; then
        echo "ERROR: $executable did not stop; refusing to replace running binaries." >&2
        exit 1
    fi
done

# Replace the whole installed bundle, rather than merging new payloads over old
# executables/resources. A source/build copy is not an installer-owned location.
if [ -L /Applications/NornicDB.app ]; then
    echo "ERROR: /Applications/NornicDB.app is a symlink; resolve it before installation." >&2
    exit 1
fi
rm -rf /Applications/NornicDB.app
rm -f /usr/local/bin/nornicdb

# Retire the old direct install location only when its bundle identifies it as
# our menu bar app. Do not delete other applications or source-tree artifacts.
legacy_app="$USER_HOME/Applications/NornicDB.app"
if [ -d "$legacy_app" ] && [ ! -L "$legacy_app" ]; then
    bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$legacy_app/Contents/Info.plist" 2>/dev/null || true)
    if [ "$bundle_id" = com.nornicdb.menubar ]; then rm -rf "$legacy_app"; fi
fi
echo "Old installed executable payloads removed; user configuration and data preserved."
