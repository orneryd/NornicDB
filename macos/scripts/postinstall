#!/bin/bash

# NornicDB Post-Install Script
# Runs after .pkg installation to set up user-specific files

set -e

# Get the actual user (not root, since installer runs as root)
ACTUAL_USER="${USER}"
if [ "$ACTUAL_USER" = "root" ]; then
    ACTUAL_USER=$(ls -l /dev/console | awk '{print $3}')
fi

USER_HOME=$(eval echo ~$ACTUAL_USER)
USER_UID=$(id -u $ACTUAL_USER)

repair_legacy_user_file() {
  local path="$1"
  if [ -L "$path" ]; then
    echo "ERROR: refusing to replace symlink at $path" >&2
    return 1
  fi
  if [ -e "$path" ] && [ "$(stat -f %u "$path")" -eq 0 ]; then
    chown "$ACTUAL_USER:staff" "$path"
  fi
}

if [ ! -x /Applications/NornicDB.app/Contents/MacOS/NornicDB ]; then
  echo "ERROR: menu bar app missing from /Applications; installation did not place the app at its intended location" >&2
  exit 1
fi

echo "Setting up NornicDB for user: $ACTUAL_USER"

# Create config directories - use ~/.nornicdb to match server's FindConfigFile priority
sudo -u "$ACTUAL_USER" mkdir -p "$USER_HOME/.nornicdb"
sudo -u "$ACTUAL_USER" mkdir -p "$USER_HOME/Library/LaunchAgents"

# Create data, models, and log directories (as root, will set ownership later)
mkdir -p /usr/local/var/nornicdb/data
mkdir -p /usr/local/var/nornicdb/models
mkdir -p /usr/local/var/log/nornicdb

# Set ownership
chown -R $ACTUAL_USER:staff /usr/local/var/nornicdb
chown -R $ACTUAL_USER:staff /usr/local/var/log/nornicdb

echo "  ✓ Created directories:"
echo "    - /usr/local/var/nornicdb/data (database)"
echo "    - /usr/local/var/nornicdb/models (AI models)"
echo "    - /usr/local/var/log/nornicdb (logs)"

# An upgrade must retain configuration, private environment, server arguments,
# and the existing first-run state. Fresh installs wait for explicit setup.
if [ ! -f "$USER_HOME/.nornicdb/config.yaml" ]; then
    sudo -u "$ACTUAL_USER" cp /usr/local/share/nornicdb/default-config.yaml "$USER_HOME/.nornicdb/config.yaml"
    sudo -u "$ACTUAL_USER" chmod 600 "$USER_HOME/.nornicdb/config.yaml"
    sudo -u "$ACTUAL_USER" touch "$USER_HOME/.nornicdb/.first_run"
fi

# Install menu bar app LaunchAgent for auto-start
repair_legacy_user_file "$USER_HOME/Library/LaunchAgents/com.nornicdb.menubar.plist"
sudo -u "$ACTUAL_USER" tee "$USER_HOME/Library/LaunchAgents/com.nornicdb.menubar.plist" > /dev/null << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nornicdb.menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-a</string>
        <string>/Applications/NornicDB.app</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
EOF

# Load the menu bar app LaunchAgent as the user
sudo -u $ACTUAL_USER launchctl load "$USER_HOME/Library/LaunchAgents/com.nornicdb.menubar.plist" 2>/dev/null || true

# Launch menu bar app immediately
if sudo -u "$ACTUAL_USER" open -a "/Applications/NornicDB.app"; then
  echo "✓ Launched menu bar app (will auto-start on login)"
else
  echo "Menu bar app could not launch now; it will start at login" >&2
fi

# Resume an existing configured service only after installation completes.
# New installs have no server plist and wait for setup/encryption selection.
if [ -f "$USER_HOME/Library/LaunchAgents/com.nornicdb.server.plist" ] && [ ! -e "$USER_HOME/.nornicdb/.first_run" ]; then
    if sudo -u "$ACTUAL_USER" launchctl bootstrap "gui/$USER_UID" "$USER_HOME/Library/LaunchAgents/com.nornicdb.server.plist"; then
        sudo -u "$ACTUAL_USER" launchctl kickstart "gui/$USER_UID/com.nornicdb.server"
    else
        echo "WARNING: Could not resume the configured server. Start it from the NornicDB menu and inspect its logs." >&2
    fi
fi

echo ""
echo "✅ NornicDB installation complete!"
echo ""
echo "The menu bar app should now be running."
echo "Look for the database icon in your menu bar (top right)."
echo ""
echo "IMPORTANT: The database server will NOT start until you complete the"
echo "first-time setup wizard. This allows you to configure encryption"
echo "BEFORE any data is written to disk."
echo ""
echo "Click the menu bar icon to begin setup."
echo ""

exit 0
